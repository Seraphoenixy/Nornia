    <x:Static x:Key="CodiconCollapseAll" Member="icons:Codicons.CollapseAll" />
    <x:Static x:Key="CodiconComment" Member="icons:Codicons.Comment" />
    <x:Static x:Key="CodiconCompareChanges" Member="icons:Codicons.CompareChanges" />
    <x:Static x:Key="CodiconCopy" Member="icons:Codicons.Copy" />
    <x:Static x:Key="CodiconDashboard" Member="icons:Codicons.Dashboard" />
    <x:Static x:Key="CodiconDiff" Member="icons:Codicons.Diff" />
    <x:Static x:Key="CodiconDiscard" Member="icons:Codicons.Discard" />
    <x:Static x:Key="CodiconEdit" Member="icons:Codicons.Edit" />
