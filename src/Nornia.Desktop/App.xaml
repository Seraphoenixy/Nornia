<Application x:Class="Nornia.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Nornia.Desktop.Converters"
             xmlns:icons="clr-namespace:Nornia.Desktop"
             xmlns:av="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:wbase="clr-namespace:System.Windows;assembly=WindowsBase">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Dark.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <!-- Codicon glyph strings are exposed as resources via x:Static object elements, so XAML never
         embeds private-use code points. Object-element form is required: a {x:Static ...} markup
         extension inside <sys:String> element content is parsed as literal text, not evaluated. -->
    <x:Static x:Key="CodiconAdd" Member="icons:Codicons.Add" />
    <x:Static x:Key="CodiconAlert" Member="icons:Codicons.Alert" />
    <x:Static x:Key="CodiconArchive" Member="icons:Codicons.Archive" />
