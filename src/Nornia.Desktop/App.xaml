    <x:Static x:Key="CodiconSymbolFile" Member="icons:Codicons.SymbolFile" />
    <x:Static x:Key="CodiconSymbolFolder" Member="icons:Codicons.SymbolFolder" />
    <x:Static x:Key="CodiconCloseSmall" Member="icons:Codicons.CloseSmall" />
    <x:Static x:Key="CodiconWhitespace" Member="icons:Codicons.Whitespace" />
    <x:Static x:Key="CodiconWordWrap" Member="icons:Codicons.WordWrap" />
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    <converters:FontAvailabilityConverter x:Key="FontAvailabilityConverter" />
    <converters:ProjectAssetDisplayConverter x:Key="ProjectAssetDisplayConverter" />
    <converters:DiffTabStatusToBrushConverter x:Key="DiffTabStatusToBrushConverter" />
    <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
    <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    <converters:GitStatusLetterConverter x:Key="GitStatusLetterConverter" />
    <converters:AddOneConverter x:Key="AddOneConverter" />
    <converters:StatusKindToBrushConverter x:Key="StatusKindToBrushConverter" />
    <converters:StatusKindToGlyphConverter x:Key="StatusKindToGlyphConverter" />
    <converters:HealthToGlyphConverter x:Key="HealthToGlyphConverter" />
    <converters:StringEmptyToCollapsedConverter x:Key="StringEmptyToCollapsedConverter" />
    <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
    <converters:NonZeroCountToVisibilityConverter x:Key="NonZeroCountToVisibilityConverter" />
    <converters:BadgeCountVisibilityConverter x:Key="BadgeCountVisibilityConverter" />
    <converters:SidebarVisibilityConverter x:Key="SidebarVisibilityConverter" />
    <converters:PathToIconGlyphConverter x:Key="PathToIconGlyphConverter" />
    <converters:PathToIconBrushConverter x:Key="PathToIconBrushConverter" />
    <converters:PathToIconMonogramConverter x:Key="PathToIconMonogramConverter" />
    <converters:FileTypeToBrushConverter x:Key="FileTypeToBrushConverter" />
    <converters:SidebarWidthConverter x:Key="SidebarWidthConverter" />
    <converters:LogPanelLevelFilterToLabelConverter x:Key="LogPanelLevelFilterToLabelConverter" />
    <converters:AppThemeToLabelConverter x:Key="AppThemeToLabelConverter" />
    <converters:AccentPresetToLabelConverter x:Key="AccentPresetToLabelConverter" />
    <converters:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
    <converters:LogLevelToGlyphConverter x:Key="LogLevelToGlyphConverter" />
    <converters:OutlineIndentConverter x:Key="OutlineIndentConverter" />
    <converters:DocumentTabVisibilityConverter x:Key="DocumentTabVisibilityConverter" />

    <!-- Color tokens (WindowBrush … DiffLineNumberBrush) are defined in the active theme dictionary (Themes/*.xaml), merged above. -->

    <!-- spacing scale. Keep the VS Code-like 4px rhythm separate from font scaling:
         the UI scale changes readable content and its containing rows, while the workbench
         frame and whitespace remain stable. -->
    <Thickness x:Key="SpaceXs">4</Thickness>
    <Thickness x:Key="SpaceSm">8</Thickness>
    <Thickness x:Key="SpaceMd">12</Thickness>
    <Thickness x:Key="SpaceLg">16</Thickness>
    <Thickness x:Key="SpaceXl">20</Thickness>
    <Thickness x:Key="SpaceXxl">24</Thickness>

    <!-- semantic insets: views use these roles instead of repeating numeric Thickness values -->
    <Thickness x:Key="InsetPage">16,12</Thickness>
    <Thickness x:Key="InsetCard">12</Thickness>
    <Thickness x:Key="InsetToolbar">12,4</Thickness>
    <Thickness x:Key="InsetSidebarTitle">12,0,8,0</Thickness>
    <Thickness x:Key="InsetMetaBar">12,4</Thickness>
    <Thickness x:Key="InsetCompactRow">8,4</Thickness>
    <Thickness x:Key="InsetBadge">8,2</Thickness>
    <Thickness x:Key="InsetLink">4,2</Thickness>
    <Thickness x:Key="InsetIconButton">8,4</Thickness>
    <Thickness x:Key="InsetStatusItem">8,0</Thickness>
    <!-- 空状态提示:图标顶边相对区域顶部的固定偏移(而非在区域内居中——居中会让同一提示的位置
         随区域高度与窗口尺寸漂移,不同功能页之间对不齐)。上下左右边距见注释。 -->
    <Thickness x:Key="EmptyStateTopInset">24,72,24,24</Thickness>

    <!-- radius scale (rounded-modern: 3 / 6 / 10, plus hero surface 14 and fully-round pill) -->
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>
    <CornerRadius x:Key="RadiusXl">14</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- motion duration scale (rounded-modern micro-interactions). Consumed by Storyboard.Duration
         in the shared animation styles below; instant = 0 for MotionService to snap when the OS
         "show animations" setting is off. -->
    <wbase:Duration x:Key="DurationInstant">0:0:0</wbase:Duration>
    <wbase:Duration x:Key="DurationFast">0:0:0.12</wbase:Duration>
    <wbase:Duration x:Key="DurationNormal">0:0:0.2</wbase:Duration>
    <wbase:Duration x:Key="DurationSlow">0:0:0.3</wbase:Duration>

    <!-- Elevation shadows (rounded-modern). App-level (not theme-level) by design: shadow is an
         elevation cue, not a color; the black shadows read softly on Dark surfaces, clearly on
         Light, and vanish automatically on the HighContrast black background. Consumed via
         {StaticResource} inside shared styles (views reference the styles, not the effects). -->
    <DropShadowEffect x:Key="ShadowCardEffect" Color="#000000" Opacity="0.16" BlurRadius="10" ShadowDepth="1" Direction="270" />
    <DropShadowEffect x:Key="ShadowPopupEffect" Color="#000000" Opacity="0.28" BlurRadius="16" ShadowDepth="3" Direction="270" />
    <DropShadowEffect x:Key="ShadowOverlayEffect" Color="#000000" Opacity="0.34" BlurRadius="24" ShadowDepth="6" Direction="270" />

    <!-- font family tokens (single source of truth; views must not hard-code family literals) -->
    <!-- Windows Chinese fallback chain on top of VS Code's Segoe WPC → Segoe UI; Mono stays configurable separately -->
    <FontFamily x:Key="UiFontFamily">Segoe WPC, Segoe UI, Microsoft YaHei</FontFamily>
    <icons:CodiconFontFamilyExtension x:Key="IconFontFamily" />
    <!-- monospace font token (replaces hard-coded "Cascadia Mono, Consolas" literals):
         主推 Cascadia Code(Win11 内建,含连字),后备 JetBrains Mono / Fira Code,兜底 Consolas -->
    <FontFamily x:Key="MonoFontFamily">Cascadia Code, JetBrains Mono, Fira Code, Consolas</FontFamily>

    <!-- type scale: Body 13 承载全部小字阶(行文本/按钮/徽标) — VS Code workbench 13px 基线;
         中间档 BodyLg 15 / Subtitle 16 / Heading 18 承接行级大正文、副标题与区块标题,避免 13→20 断层;
         大字阶 Title 20 / Display 22 / Hero 26。
         All text font sizes ride these tokens via DynamicResource so the global UI font scale
          (UiFontService) can rewrite them at runtime without a restart. -->
    <sys:Double x:Key="TypeBody">13</sys:Double>
    <!-- VS Code CountBadge uses an 11px label inside an 18px badge. Keep this separate from
         IconBadge, which is the smaller file-monogram glyph token. -->
    <sys:Double x:Key="TypeBadge">11</sys:Double>
    <sys:Double x:Key="TypeBodyLg">15</sys:Double>
    <sys:Double x:Key="TypeSubtitle">16</sys:Double>
    <sys:Double x:Key="TypeHeading">18</sys:Double>
    <sys:Double x:Key="TypeTitle">20</sys:Double>
    <sys:Double x:Key="TypeDisplay">22</sys:Double>
    <sys:Double x:Key="TypeHero">26</sys:Double>

    <!-- icon glyph scale (IconFontFamily): one size per glyph role, same semantics = same size.
         行级图标(文件/目录/树节点/行操作/标签字形/状态栏图形等)一律 IconInline(12);
         折叠箭头 IconChevron(9),其余按角色分离:导航 15 / 窗口控制 12 / 活动栏 19 / 空态 28。 -->
    <sys:Double x:Key="IconChevron">9</sys:Double>
    <sys:Double x:Key="IconInline">12</sys:Double>
    <sys:Double x:Key="IconNav">15</sys:Double>
    <!-- Window controls use a compact glyph even though their hit area remains system-sized. -->
    <sys:Double x:Key="IconClose">12</sys:Double>
    <sys:Double x:Key="IconActivity">24</sys:Double>
    <sys:Double x:Key="IconActivityCompact">16</sys:Double>
    <sys:Double x:Key="IconEmpty">28</sys:Double>
    <!-- 文件类型图标的语言缩写文字档(透明底 + 语言色相的 Monogram) -->
    <sys:Double x:Key="IconBadge">9</sys:Double>
    <sys:Double x:Key="IconMonogram">12</sys:Double>
    <!-- 文件类型 Monogram 单元格尺寸(随全局界面缩放,见 UiFontService):Viewbox 以该尺寸为界把
         缩写文字等比缩放到“恰好容纳”,任意长度/缩放下都不溢出相邻列。 -->
    <sys:Double x:Key="IconMonogramSlot">18</sys:Double>
    <sys:Double x:Key="IconMonogramCell">18</sys:Double>
    <Style x:Key="FileTypeMonogramTextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource IconMonogram}" />
      <Setter Property="FontWeight" Value="Black" />
      <Setter Property="Width" Value="18" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <!-- measurement tokens: row/control heights that must grow with the UI font scale.
         Frame metrics (window size, splitters, radii, borders) stay static by design.
         TitleBar/SideBarTitle/TabBar 35px, compact row 22px(VS Code 默认桌面密度);StatusBar 28px(合并文档状态段后加高,单行布局不变)。 -->
    <sys:Double x:Key="SizeRowSm">22</sys:Double>
    <sys:Double x:Key="SizeRowCompact">22</sys:Double>
    <sys:Double x:Key="SizeSidebarBadge">18</sys:Double>
    <sys:Double x:Key="SizeTableRow">22</sys:Double>
    <sys:Double x:Key="SizeRowMd">26</sys:Double>
    <sys:Double x:Key="SizeControlMd">24</sys:Double>
    <sys:Double x:Key="SizeStatusBar">28</sys:Double>
    <sys:Double x:Key="SizeTitleBar">35</sys:Double>
    <sys:Double x:Key="SizeCommandPalette">620</sys:Double>
    <sys:Double x:Key="SizeActivity">48</sys:Double>
    <sys:Double x:Key="SizeActivityCompact">36</sys:Double>
    <sys:Double x:Key="SizeActivityActionCompact">28</sys:Double>
    <sys:Double x:Key="SizeTabBar">35</sys:Double>
    <!-- Workbench frame metrics: these stay fixed across font scaling so adjacent regions retain
         crisp VS Code-like seams and a usable editor surface. -->
    <sys:Double x:Key="SizeWorkbenchSplitter">4</sys:Double>
    <sys:Double x:Key="SizeSashHitArea">8</sys:Double>
    <sys:Double x:Key="MinEditorWidth">520</sys:Double>
    <!-- 单个编辑器组最小宽高:组拆分后即使窗口变窄也不坍缩为不可用窄条 -->
    <sys:Double x:Key="MinEditorGroupWidth">240</sys:Double>
    <sys:Double x:Key="MinEditorGroupHeight">160</sys:Double>
    <sys:Double x:Key="SizeCommitBox">40</sys:Double>

    <!-- Shared VS Code-like count badge. Count badges are compact information labels; the
         reference badge below deliberately has its own visual treatment. -->
    <Style x:Key="SidebarCountBadgeStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SidebarBadgeBackgroundBrush}" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
      <Setter Property="Height" Value="{DynamicResource SizeSidebarBadge}" />
      <Setter Property="MinHeight" Value="{DynamicResource SizeSidebarBadge}" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="SidebarCountBadgeTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeBadge}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarBadgeForegroundBrush}" />
      <Setter Property="LineHeight" Value="{DynamicResource TypeBadge}" />
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SidebarReferenceBadgeStyle" TargetType="Border">
      <!-- scmHistoryViewPane.ts: line-height 18px, border-radius 10px, flex-centered label. -->
      <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
      <Setter Property="Height" Value="{DynamicResource SizeSidebarBadge}" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- directional spacing (V4): top-gap + label-right-gap on the 4/8/12/16 scale -->
    <Thickness x:Key="GapXs">0,4,0,0</Thickness>
    <Thickness x:Key="GapSm">0,8,0,0</Thickness>
    <Thickness x:Key="GapMd">0,12,0,0</Thickness>
    <Thickness x:Key="GapLg">0,16,0,0</Thickness>
    <Thickness x:Key="GapLeftSm">0,0,8,0</Thickness>
    <Thickness x:Key="GapLeftMd">0,0,12,0</Thickness>
    <Thickness x:Key="GapLeftLg">0,0,16,0</Thickness>
    <Thickness x:Key="GapBottomSm">0,0,0,8</Thickness>
    <Thickness x:Key="GapBottomMd">0,0,0,12</Thickness>
    <Thickness x:Key="GapRightSm">0,0,8,0</Thickness>
    <Thickness x:Key="GapRightMd">0,0,12,0</Thickness>
    <Thickness x:Key="GapVerticalSm">0,8</Thickness>
    <Thickness x:Key="MarginFieldRow">0,8,0,4</Thickness>
    <Thickness x:Key="MarginActionsRow">0,4,0,8</Thickness>
    <Thickness x:Key="MarginBanner">0,12,0,8</Thickness>
    <Thickness x:Key="MarginCard">0,0,8,8</Thickness>

    <Style TargetType="Window">
      <!-- Family does not ride the font scale (StaticResource); the base text size does (DynamicResource)
           so inherited text everywhere follows the global UI font scale. -->
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <!-- 全局垂直居中:容器(横向堆叠行 / Grid 固定高格 / 图标字形等)高于文字时,默认 Stretch
           会让文字顶对齐,这里统一为 Center;已显式指定对齐的元素不受影响。 -->
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Unified accent focus ring for keyboard navigation. WPF renders FocusVisualStyle only when
         the control receives keyboard focus (VS Code: no ring after a plain mouse click). -->
    <Style x:Key="AppFocusRing" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border BorderBrush="{DynamicResource FocusBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- VS Code-like sash: an 8px transparent WPF hit area with a 4px visual track. -->
    <Style x:Key="VerticalSashStyle" TargetType="GridSplitter">
      <Setter Property="Width" Value="{DynamicResource SizeSashHitArea}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="Transparent">
              <Border x:Name="Track" Width="{DynamicResource SizeWorkbenchSplitter}"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="{DynamicResource SashBrush}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource SashHoverBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource SashHoverBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HorizontalSashStyle" TargetType="GridSplitter">
      <Setter Property="Height" Value="{DynamicResource SizeSashHitArea}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="Transparent">
              <Border x:Name="Track" Height="{DynamicResource SizeWorkbenchSplitter}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="{DynamicResource SashBrush}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource SashHoverBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource SashHoverBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <!-- 所有按钮文本统一 body 档(13),与行文本/区块头同档,不再有大小不一的混排 -->
      <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
      <Setter Property="Padding" Value="{StaticResource InsetToolbar}" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinHeight" Value="{DynamicResource SizeRowMd}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusSm}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <!-- Busy guard (existing long-task feedback): conflicts disable the button app-wide. -->
              <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
              <!-- Disabled: reduced contrast + no hand cursor -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource PressedBorderBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Global thin scrollbar (VS Code sidebar: slim translucent rounded thumb, no arrows). The implicit
         TargetType=ScrollBar style applies to every ScrollViewer/TextBox/DataGrid in the app, including
         the Git sidebar scroll area and the commit message box's embedded scrollbar.
         注意:宽度/高度不能同时写死——竖直滚动条由 ScrollViewer 的网格拉伸为整段高度,若样式固定
         Height 会把滚动条坍缩成 10px 高的小块(侧栏滚动条错位不可用)。厚度按 Orientation 触发器设置。
         还必须清零 MinWidth/MinHeight:WPF 默认主题的 ScrollBar 样式把它们钉在
         SystemParameters 的 17px(竖宽/横高)上,若只改 Width/Height,布局仍按 max(改动值, 17)
         展开,全局改细会"无效"。 -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <!-- 竖轴:8px 命中区域，Thumb 自身通过 Margin 留出边距；高度交给宿主拉伸。 -->
      <Setter Property="Width" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
              <!-- track: transparent PageUp/PageDown region, clickable to page.
                   IsDirectionReversed 只对垂直为 true(WPF 默认模板:垂直 true / 水平 false):
                   Value 增大 → 垂直 Thumb 下移、水平 Thumb 右移。方向写死 true 会把横向
                   滚动条的方向与 Thumb 位置语义都弄反,故用 Style 触发器在水平时切回 false。 -->
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Value="{TemplateBinding Value}" Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}">
                <Track.Style>
                  <Style TargetType="Track">
                    <Setter Property="IsDirectionReversed" Value="True" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                        <Setter Property="IsDirectionReversed" Value="False" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Track.Style>
                <Track.Thumb>
                  <Thumb x:Name="Thumb">
                    <Thumb.Style>
                      <Style TargetType="Thumb">
                        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Margin" Value="1,0" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                              <!-- Keep the thumb rectangular with only a small radius. RadiusPill made
                                   short thumbs look like a spindle/hourglass. -->
                              <Border Background="{TemplateBinding Background}" CornerRadius="2"
                                      BorderThickness="0" SnapsToDevicePixels="True" />
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                            <Setter Property="Margin" Value="0,1" />
                          </DataTrigger>
                          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" /></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{DynamicResource ScrollBarThumbActiveBrush}" /></Trigger>
                          <Trigger Property="IsMouseCaptured" Value="True"><Setter Property="Background" Value="{DynamicResource ScrollBarThumbActiveBrush}" /></Trigger>
                        </Style.Triggers>
                      </Style>
                    </Thumb.Style>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- 横轴(文本框/列表横向滚动):满宽、8px 命中区域，Thumb 上下留边。 -->
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="8" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource DangerPressedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DangerPressedBrush}" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <!-- 图标按钮的字形默认走行内图标档(12);文本按钮可再覆盖为 TypeBody — 4px 标度 -->
      <Setter Property="FontSize" Value="{DynamicResource IconInline}" />
      <Setter Property="Padding" Value="{StaticResource InsetIconButton}" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="{DynamicResource SizeControlMd}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PressedBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- Window control buttons (min/max/close): Codicon glyphs via the icon font token, so the
         caption strip never hard-codes a font family. Hit area stays generous via horizontal padding. -->
    <Style x:Key="WindowControlButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource IconClose}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- VS Code title-bar icon buttons (back/forward + layout toggles): compact borderless glyph
         buttons spanning the full caption-strip height; hover/pressed/disabled states ride the
         shared interaction tokens (IconButton already supplies the disabled fade + arrow cursor). -->
    <Style x:Key="TitleBarIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="{DynamicResource SizeTitleBar}" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PressedBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="{StaticResource InsetLink}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource ButtonPressedBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PanelTabButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Foreground" Value="{DynamicResource PanelTitleInactiveForegroundBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
      <Setter Property="Padding" Value="0,0,0,1" />
      <Setter Property="Margin" Value="0,0,18,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="BorderThickness" Value="0,2,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource PanelTitleActiveForegroundBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- VS Code status-bar item: full-height clickable cell with hover/pressed/focus feedback — VS Code default 22px -->
    <Style x:Key="StatusBarItem" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource StatusBarForegroundBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Height" Value="{DynamicResource SizeStatusBar}" />
      <Setter Property="Padding" Value="{StaticResource InsetStatusItem}" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="StatusItem" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
              <!-- keyboard focus: 1px ring in the status-bar foreground (visible on every theme bar) -->
              <Border x:Name="FocusRing" BorderBrush="{DynamicResource StatusBarForegroundBrush}" BorderThickness="1" Visibility="Collapsed" SnapsToDevicePixels="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StatusItem" Property="Background" Value="{DynamicResource StatusBarItemHoverBackgroundBrush}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="StatusItem" Property="Background" Value="{DynamicResource StatusBarItemPressedBackgroundBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource DangerPressedBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="{DynamicResource SizeRowMd}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="{DynamicResource SizeRowMd}" />
      <!-- 显式模板:默认模板把下拉弹出层钉在系统调色板(多数系统呈白色)上,这里改走主题令牌 -->
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True">
              <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <!-- The templated parent here is ToggleButton, whose default Background is
                         the system control colour (white). Bind to the owning ComboBox instead
                         so the closed selector stays on the dark input surface. -->
                    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            CornerRadius="{StaticResource RadiusSm}">
                      <TextBlock Text="{StaticResource CodiconChevronDown}" FontFamily="{StaticResource IconFontFamily}"
                                 FontSize="{DynamicResource IconChevron}" Foreground="{DynamicResource MutedTextBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" />
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                     PopupAnimation="Fade" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <!-- 下拉表面:弹出层走菜单令牌,杜绝默认模板的白色底 -->
                <Border x:Name="DropDownBorder" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{DynamicResource MenuBackgroundBrush}"
                        BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}" SnapsToDevicePixels="True"
                        Effect="{StaticResource ShadowPopupEffect}">
                  <ScrollViewer Background="{DynamicResource MenuBackgroundBrush}">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Padding" Value="8,4" />
      <!-- 显式模板:项面填满下拉表面,悬停高亮走主题令牌,消除默认模板的白色缝隙 -->
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionActiveBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionActiveBrush}" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- Checkbox (VS Code list checkbox):显式模板跟随主题——盒面/边框走主题令牌,
         勾选 = 强调色填充 + 亮色对勾,悬停边框加深;不再使用默认 Aero2 白盒蓝勾渲染。
         作用于查找栏(大小写/全词/正则/所选范围)、设置页开关与缓存清理列。 -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="{TemplateBinding Background}">
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Border x:Name="Box" Width="16" Height="16" CornerRadius="{StaticResource RadiusSm}"
                        Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
                  <Path x:Name="Check" Data="M3.2 8.4 L6.8 11.8 L12.8 4.6"
                        Stroke="{DynamicResource BrightTextBrush}" StrokeThickness="1.8"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Border>
                <ContentPresenter x:Name="Label" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- Keep list virtualization explicit for large catalogs, SCM rows and diagnostics. A view
         that deliberately supplies a non-virtualizing ItemsPanel can still override this. -->
    <Style TargetType="ListBox">
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource EditorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="RowBackground" Value="{DynamicResource EditorBrush}" />
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource SideHeaderBrush}" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="EnableRowVirtualization" Value="True" />
      <Setter Property="EnableColumnVirtualization" Value="True" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <!-- VS Code compact density: uniform 22px row — header/cell padding unified at 8,2 -->
      <Setter Property="RowHeight" Value="{DynamicResource SizeTableRow}" />
      <Setter Property="MinRowHeight" Value="{DynamicResource SizeTableRow}" />
      <Setter Property="ColumnHeaderHeight" Value="{DynamicResource SizeTableRow}" />
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
        <Trigger Property="IsMouseCaptured" Value="True"><Setter Property="Background" Value="{DynamicResource PressedBrush}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionActiveBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionActiveBrush}" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- accent-colored keyboard focus ring for grid cells (replaces removed default) -->
    <Style x:Key="CellFocusVisual" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border BorderBrush="{DynamicResource FocusBorderBrush}" BorderThickness="1" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridCell">
      <!-- 样式表数据的文字统一垂直居中:数据页(Runtime/Tools/Packages/Cache/Projects)使用固定
           22px 行高(VS Code compact table),单元格内容必须垂直居中,不能沿用默认的顶部对齐。 -->
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource CellFocusVisual}" />
    </Style>

    <!-- 环境管理页显式指定此样式，确保扫描后动态生成/虚拟化的 DataGridCell 不依赖外层隐式资源继承。 -->
    <Style x:Key="EnvironmentDataGridCellStyle" TargetType="DataGridCell"
           BasedOn="{StaticResource {x:Type DataGridCell}}">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- DataGridTextColumn creates TextBlock elements after rows are materialized. Explicitly center
         those elements as well; DataGridCell.VerticalContentAlignment alone does not change the
         generated TextBlock's own alignment. -->
    <Style x:Key="EnvironmentDataGridTextStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 全局 ListBox 行四态 (VS Code: hover → pressed → selected → keyboard focus ring)。
         数据页(Runtime/Tools/Packages/Cache/Projects)的列表没有各自的行模板,统一在这里获得交互反馈;
         已使用 keyed/局部样式的列表(活动栏 / 标签条 / SCM / 环境侧栏 / 快速输入)不受影响。 -->
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <Grid>
                <!-- Overlay layers (rounded-modern micro-interaction): feedback tints stay on theme
                     brushes (DynamicResource) and only Opacity animates, so theme switches never
                     leave stale animated colors. -->
                <Border x:Name="HoverLayer" Background="{DynamicResource HoverBrush}" Opacity="0" />
                <Border x:Name="SelectedLayer" Background="{DynamicResource SelectionBrush}" Opacity="0" />
                <Border x:Name="PressedLayer" Background="{DynamicResource PressedBrush}" Opacity="0" />
                <Border x:Name="FocusLayer" Background="{DynamicResource SelectionActiveBrush}" Opacity="0" />
                <ContentPresenter />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurationFast}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurationFast}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurationFast}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SelectedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurationFast}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseCaptured" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurationFast}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PressedLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurationFast}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="FocusLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurationFast}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="FocusLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurationFast}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SidebarRowItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="{DynamicResource SizeRowSm}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource EditorBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontWeight" Value="Normal" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
      </Style.Triggers>
    </Style>

    <!-- VS Code side-bar title bar: view title row with letter-spaced small caps — 35px VS Code baseline -->
    <Style x:Key="SideBarTitleBarStyle" TargetType="Grid">
      <Setter Property="Height" Value="{DynamicResource SizeTitleBar}" />
      <Setter Property="Margin" Value="{StaticResource InsetSidebarTitle}" />
    </Style>
    <Style x:Key="SideBarTitleTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SideBarTitleForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- VS Code side-bar section header (chevron + letter-spaced label + actions) — 4px scale -->
    <Style x:Key="SideBarSectionHeaderStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SideBarSectionHeaderBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SideBarSectionHeaderBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,1" />
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style x:Key="SideBarSectionHeaderTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SideBarSectionHeaderForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Effect" Value="{StaticResource ShadowCardEffect}" />
    </Style>

    <!-- Right-click menus follow the active theme (VS Code-style quick / context menus).
         显式模板:默认模板把弹出表面/图标栏/分隔线钉在系统调色板(多数系统呈白色)上,这里改走主题令牌。 -->
    <Style TargetType="Separator">
      <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="8,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}" SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{DynamicResource MenuBackgroundBrush}"
                    BorderBrush="{DynamicResource StrongBorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                    Effect="{StaticResource ShadowPopupEffect}">
              <ScrollViewer Background="{DynamicResource MenuBackgroundBrush}" Foreground="{TemplateBinding Foreground}">
                <ItemsPresenter />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <!-- 四角色模板(TopLevelHeader/TopLevelItem/SubmenuHeader/SubmenuItem):高亮底色经 TemplateBinding
           Background 交给各自样式驱动(默认菜单项走 MenuSelection 令牌,标题栏样式走 Hover 令牌),
           子菜单弹出层与左侧图标栏改走主题令牌,杜绝默认模板白底。 -->
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid SnapsToDevicePixels="True">
              <Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusSm}" />
              <Grid x:Name="TopLevelTemplate" Visibility="Collapsed">
                <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Header" RecognizesAccessKey="True"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Grid>
              <Grid x:Name="SubmenuTemplate" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition MinWidth="24" SharedSizeGroup="MenuItemIconColumnGroup" Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIGTColumnGroup" />
                  <ColumnDefinition Width="14" />
                </Grid.ColumnDefinitions>
                <Border x:Name="GlyphPanel" Background="{DynamicResource MenuBackgroundBrush}" Margin="2" Padding="3"
                        Visibility="Collapsed" VerticalAlignment="Center" CornerRadius="{StaticResource RadiusSm}">
                  <ContentPresenter x:Name="IconPresenter" ContentSource="Icon" />
                </Border>
                <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Margin="24,0,4,0" Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="SubmenuArrow" Grid.Column="3" Margin="0,0,4,0" FontFamily="{StaticResource IconFontFamily}"
                           FontSize="{DynamicResource IconChevron}" Text="{StaticResource CodiconChevronRight}" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
              </Grid>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Right" PopupAnimation="Fade"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border x:Name="SubmenuBorder" Background="{DynamicResource MenuBackgroundBrush}"
                        BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}" Padding="2" SnapsToDevicePixels="True"
                        Effect="{StaticResource ShadowPopupEffect}">
                  <ScrollViewer Background="{DynamicResource MenuBackgroundBrush}">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Role" Value="TopLevelHeader">
                <Setter TargetName="TopLevelTemplate" Property="Visibility" Value="Visible" />
                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
              </Trigger>
              <Trigger Property="Role" Value="TopLevelItem">
                <Setter TargetName="TopLevelTemplate" Property="Visibility" Value="Visible" />
                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="SubmenuTemplate" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="Role" Value="SubmenuItem">
                <Setter TargetName="SubmenuTemplate" Property="Visibility" Value="Visible" />
                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource MenuSelectionBackgroundBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- VS Code title-bar menu bar: transparent surface over the caption strip, compact top-level
         items with hover highlight. Inheriting the themed MenuItem style is important here:
         otherwise the top-level item's popup falls back to the system menu template/colors. -->
    <Style x:Key="TitleBarMenuStyle" TargetType="Menu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="TitleBarMenuItemStyle" TargetType="MenuItem"
           BasedOn="{StaticResource {x:Type MenuItem}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45" />
          <Setter Property="Cursor" Value="Arrow" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ===== Layout primitives (Phase 1) ===== -->
    <!-- Large workbench pages stretch to the full content width; narrow pages (e.g. Settings) opt
         into a centered constrained layout explicitly on their own root element. -->
    <!-- Page root supplies type and surface primitives only. Its host owns page inset so embedded
         views (for example Cache inside Packages) do not receive accidental double padding. -->
    <Style x:Key="PageRootStyle" TargetType="Grid" />

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
    </Style>

    <!-- page title / hero title (V3) -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
    </Style>
    <Style x:Key="PageHeroTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeDisplay}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
    </Style>
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <!-- intermediate type ladder (rounded-modern): BodyLg / Subtitle / Section title fill the 13→20 gap -->
    <Style x:Key="BodyLgTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeBodyLg}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeSubtitle}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeHeading}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
    </Style>

    <!-- single-line selection summary strip (V3): dense, no card chrome -->
    <Style x:Key="SelectionSummaryStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="InfoBannerStyle" TargetType="Border">
      <Setter Property="Padding" Value="{StaticResource InsetCard}" />
      <Setter Property="Background" Value="{DynamicResource InfoBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <!-- 不挂 DropShadowEffect:Effect 会把承载元素的整棵子树(含文字)栅格化再合成,
           文字变糊(任务中心横幅/卡片、设置页卡片的模糊都源于此);用边框 + 背景保持层次。 -->
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="{StaticResource InsetCard}" />
      <!-- 同上:阴影让卡片内文字随 Effect 栅格化变糊(指标数字最明显),去掉阴影保清晰。
           Border 没有 Template 属性,无法把阴影拆到独立底层;统一用边框线做卡片层次。 -->
    </Style>

    <!-- Dashboard/overview metric card: identical surface to CardStyle (one border/padding spec) -->
    <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}" />

    <!-- Compact status badge used inside table cells (state column): bordered pill, 11px label.
         Foreground is set per value by the consuming cell (Success/Warning/Danger tokens). — 4px scale -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
      <Setter Property="Padding" Value="{StaticResource InsetBadge}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Settings page group card: uniform title/body padding and group spacing -->
    <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
      <Setter Property="Padding" Value="{StaticResource SpaceMd}" />
      <Setter Property="Margin" Value="{StaticResource GapMd}" />
    </Style>

    <!-- shared toolbar row: filter/search on the left, batch actions right-aligned and wrap-capable.
         The actions panel lives in a star column so buttons wrap instead of clipping at narrow
         widths while keeping the primary action visible. — 4px scale -->
    <Style x:Key="ToolbarRowStyle" TargetType="Grid">
      <Setter Property="Margin" Value="{StaticResource GapVerticalSm}" />
    </Style>
    <Style x:Key="ToolbarActionsStyle" TargetType="WrapPanel">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!-- page-level primary/secondary screen feedback strip (result zone): dense single line — 4px scale -->
    <Style x:Key="ResultStripStyle" TargetType="TextBlock" BasedOn="{StaticResource SelectionSummaryStyle}">
      <Setter Property="Margin" Value="{StaticResource GapVerticalSm}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- list / todo row rendered as a button (V8): card surface, consistent padding & border.
         行级阴影在 VS Code 风格里不必要,且会让行内文字随 Effect 栅格化变糊——只保留边框层次。 -->
    <Style x:Key="ListItemButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="{StaticResource InsetCard}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PressedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PressedBorderBrush}" /></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="EmptyStateStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Margin" Value="{StaticResource SpaceXxl}" />
    </Style>

    <!-- Dark TabControl / TabItem so tabbed pages stay consistent with the VS Code Dark Modern theme -->
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SideHeaderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
              <Trigger Property="IsMouseCaptured" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 代码编辑器(TextEditor)全局排版:Display 格式化 + ClearType 渲染消除像素模糊,
         UseLayoutRounding 对齐物理像素,Padding 给代码区适度呼吸空间。
         代码源视图(CodeDocumentView)与 Diff 视图(DiffDocumentView)的全部编辑器共用,
         排版一致;各视图显式设置的 Background/Foreground/FontFamily/FontSize 不受影响。 -->
    <Style TargetType="av:TextEditor">
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
      <Setter Property="UseLayoutRounding" Value="True" />
      <Setter Property="Padding" Value="4,2,4,2" />
    </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
