    <x:Static x:Key="CodiconFile" Member="icons:Codicons.File" />
    <x:Static x:Key="CodiconFileMedia" Member="icons:Codicons.FileMedia" />
    <x:Static x:Key="CodiconFiles" Member="icons:Codicons.Files" />
    <x:Static x:Key="CodiconFolder" Member="icons:Codicons.Folder" />
    <x:Static x:Key="CodiconFolderLibrary" Member="icons:Codicons.FolderLibrary" />
    <x:Static x:Key="CodiconFolderOpened" Member="icons:Codicons.FolderOpened" />
    <x:Static x:Key="CodiconGear" Member="icons:Codicons.Gear" />
    <x:Static x:Key="CodiconGitBranch" Member="icons:Codicons.GitBranch" />
    <x:Static x:Key="CodiconGitCommit" Member="icons:Codicons.GitCommit" />
    <x:Static x:Key="CodiconGitCompare" Member="icons:Codicons.GitCompare" />
