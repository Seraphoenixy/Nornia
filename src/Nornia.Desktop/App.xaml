    <x:Static x:Key="CodiconRefresh" Member="icons:Codicons.Refresh" />
    <x:Static x:Key="CodiconRemoteExplorer" Member="icons:Codicons.RemoteExplorer" />
    <x:Static x:Key="CodiconRemove" Member="icons:Codicons.Remove" />
    <x:Static x:Key="CodiconRepo" Member="icons:Codicons.Repo" />
    <x:Static x:Key="CodiconReplaceAll" Member="icons:Codicons.ReplaceAll" />
    <x:Static x:Key="CodiconRocket" Member="icons:Codicons.Rocket" />
    <x:Static x:Key="CodiconSave" Member="icons:Codicons.Save" />
    <x:Static x:Key="CodiconSearch" Member="icons:Codicons.Search" />
    <x:Static x:Key="CodiconServerProcess" Member="icons:Codicons.ServerProcess" />
    <x:Static x:Key="CodiconSettings" Member="icons:Codicons.Settings" />
    <x:Static x:Key="CodiconSourceControl" Member="icons:Codicons.SourceControl" />
    <x:Static x:Key="CodiconSplitHorizontal" Member="icons:Codicons.SplitHorizontal" />
    <x:Static x:Key="CodiconSplitVertical" Member="icons:Codicons.SplitVertical" />
    <x:Static x:Key="CodiconStar" Member="icons:Codicons.Star" />
    <x:Static x:Key="CodiconSync" Member="icons:Codicons.Sync" />
    <x:Static x:Key="CodiconTerminal" Member="icons:Codicons.Terminal" />
    <x:Static x:Key="CodiconTools" Member="icons:Codicons.Tools" />
    <x:Static x:Key="CodiconTrash" Member="icons:Codicons.Trash" />
    <x:Static x:Key="CodiconTriangleDown" Member="icons:Codicons.TriangleDown" />
    <x:Static x:Key="CodiconTriangleRight" Member="icons:Codicons.TriangleRight" />
    <x:Static x:Key="CodiconUnfold" Member="icons:Codicons.Unfold" />
