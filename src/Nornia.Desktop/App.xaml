    <x:Static x:Key="CodiconArrowRight" Member="icons:Codicons.ArrowRight" />
    <x:Static x:Key="CodiconArrowUp" Member="icons:Codicons.ArrowUp" />
    <x:Static x:Key="CodiconBeaker" Member="icons:Codicons.Beaker" />
    <x:Static x:Key="CodiconBook" Member="icons:Codicons.Book" />
    <x:Static x:Key="CodiconBrowser" Member="icons:Codicons.Browser" />
    <x:Static x:Key="CodiconCheck" Member="icons:Codicons.Check" />
    <x:Static x:Key="CodiconCheckAll" Member="icons:Codicons.CheckAll" />
    <x:Static x:Key="CodiconChevronDown" Member="icons:Codicons.ChevronDown" />
    <x:Static x:Key="CodiconChevronLeft" Member="icons:Codicons.ChevronLeft" />
    <x:Static x:Key="CodiconChevronRight" Member="icons:Codicons.ChevronRight" />
    <x:Static x:Key="CodiconChevronUp" Member="icons:Codicons.ChevronUp" />
    <x:Static x:Key="CodiconChromeClose" Member="icons:Codicons.ChromeClose" />
    <x:Static x:Key="CodiconChromeMaximize" Member="icons:Codicons.ChromeMaximize" />
    <x:Static x:Key="CodiconChromeMinimize" Member="icons:Codicons.ChromeMinimize" />
    <x:Static x:Key="CodiconChromeRestore" Member="icons:Codicons.ChromeRestore" />
    <x:Static x:Key="CodiconCircleFilled" Member="icons:Codicons.CircleFilled" />
    <x:Static x:Key="CodiconClearAll" Member="icons:Codicons.ClearAll" />
    <x:Static x:Key="CodiconClose" Member="icons:Codicons.Close" />
    <x:Static x:Key="CodiconCloseAll" Member="icons:Codicons.CloseAll" />
    <x:Static x:Key="CodiconCloud" Member="icons:Codicons.Cloud" />
    <x:Static x:Key="CodiconCloudDownload" Member="icons:Codicons.CloudDownload" />
    <x:Static x:Key="CodiconCloudUpload" Member="icons:Codicons.CloudUpload" />
