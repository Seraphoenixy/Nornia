    <x:Static x:Key="CodiconGitStashPop" Member="icons:Codicons.GitStashPop" />
    <x:Static x:Key="CodiconGithub" Member="icons:Codicons.Github" />
    <x:Static x:Key="CodiconGoToFile" Member="icons:Codicons.GoToFile" />
    <x:Static x:Key="CodiconHistory" Member="icons:Codicons.History" />
    <x:Static x:Key="CodiconGraphLine" Member="icons:Codicons.GraphLine" />
    <x:Static x:Key="CodiconInfo" Member="icons:Codicons.Info" />
    <x:Static x:Key="CodiconLayoutPanel" Member="icons:Codicons.LayoutPanel" />
    <x:Static x:Key="CodiconLayoutSidebarLeft" Member="icons:Codicons.LayoutSidebarLeft" />
    <x:Static x:Key="CodiconKeyboard" Member="icons:Codicons.Keyboard" />
    <x:Static x:Key="CodiconLightbulb" Member="icons:Codicons.Lightbulb" />
    <x:Static x:Key="CodiconListFlat" Member="icons:Codicons.ListFlat" />
    <x:Static x:Key="CodiconListTree" Member="icons:Codicons.ListTree" />
    <x:Static x:Key="CodiconLoading" Member="icons:Codicons.Loading" />
    <x:Static x:Key="CodiconMenu" Member="icons:Codicons.Menu" />
    <x:Static x:Key="CodiconMap" Member="icons:Codicons.Map" />
    <x:Static x:Key="CodiconMore" Member="icons:Codicons.More" />
    <x:Static x:Key="CodiconNewFile" Member="icons:Codicons.NewFile" />
    <x:Static x:Key="CodiconNewFolder" Member="icons:Codicons.NewFolder" />
    <x:Static x:Key="CodiconNewSession" Member="icons:Codicons.NewSession" />
    <x:Static x:Key="CodiconOpenPreview" Member="icons:Codicons.OpenPreview" />
    <x:Static x:Key="CodiconOpenInWindow" Member="icons:Codicons.OpenInWindow" />
    <x:Static x:Key="CodiconOutput" Member="icons:Codicons.Output" />
    <x:Static x:Key="CodiconPackage" Member="icons:Codicons.Package" />
    <x:Static x:Key="CodiconPass" Member="icons:Codicons.Pass" />
