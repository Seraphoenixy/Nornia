<UserControl x:Class="Nornia.Desktop.Views.FilePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nornia.Desktop.Views">
  <Grid Background="{DynamicResource EditorBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- VS Code-style breadcrumb + editor actions (top row) -->
    <Border Grid.Row="0" Background="{DynamicResource EditorGroupHeaderTabsBackgroundBrush}"
            BorderBrush="{DynamicResource TabBorderBrush}" BorderThickness="0,0,0,1"
            MinHeight="{DynamicResource SizeRowMd}" Padding="8,1" SnapsToDevicePixels="True">
      <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- 面包屑行不再显示文件类型 Monogram:文件类型由编辑区标签徽标与窗口主状态栏的
             "当前文档状态"段(可点击的语言项)承载,面包屑只保留路径 + 符号链。 -->
        <Border Grid.Column="0" ClipToBounds="True" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 面包屑分段链(VS Code breadcrumb):路径段在可伸缩区域内保持单行，
                 每个段和符号段分别使用省略号，绝不挤压右侧编辑器操作。 -->
            <ItemsControl x:Name="BreadcrumbBar" ItemsSource="{Binding BreadcrumbSegments}"
                          VerticalAlignment="Center" Focusable="True" KeyDown="BreadcrumbBar_KeyDown">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="›" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource SubtleTextBrush}"
                               VerticalAlignment="Center" Margin="6,0"
                               Visibility="{Binding ShowChevron, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Style="{StaticResource LinkButton}" Padding="0,0" Content="{Binding Display}"
                            ToolTip="{Binding FullPath}"
                            Command="{Binding DataContext.RevealBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=views:EditorAreaView}}"
                            CommandParameter="{Binding}">
                      <Button.ContentTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap"
                                                  TextTrimming="CharacterEllipsis" MaxWidth="140" /></DataTemplate>
                      </Button.ContentTemplate>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 光标行所属的符号祖先链与路径保持同一行。 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding HasActiveSymbol, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="›" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource SubtleTextBrush}"
                         VerticalAlignment="Center" Margin="6,0" />
              <ItemsControl ItemsSource="{Binding ActiveSymbolPath}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="›" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource SubtleTextBrush}"
                                 VerticalAlignment="Center" Margin="4,0" />
                      <Button Style="{StaticResource LinkButton}" Padding="0,0" FontStyle="Italic"
                              Command="{Binding DataContext.JumpToSymbolCommand, RelativeSource={RelativeSource AncestorType=views:FilePreviewView}}"
                              CommandParameter="{Binding}" ToolTip="跳转到符号声明">
                        <TextBlock Text="{Binding DisplayName}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" MaxWidth="160" />
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsMarkdown, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Content="预览" Style="{StaticResource LinkButton}" Padding="4,1"
                    Command="{Binding ShowMarkdownPreviewCommand}" ToolTip="显示 Markdown 渲染结果" />
            <Button Content="源码" Style="{StaticResource LinkButton}" Padding="4,1" Margin="4,0,2,0"
                    Command="{Binding ShowMarkdownSourceCommand}" ToolTip="显示 Markdown 源码" />
          </StackPanel>
          <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconSearch}" FontFamily="{StaticResource IconFontFamily}" Padding="4,2"
                  Command="{Binding OpenFindBarCommand}" ToolTip="查找（Ctrl+F）" AutomationProperties.Name="查找" />
          <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconGoToFile}" FontFamily="{StaticResource IconFontFamily}" Padding="4,1" Margin="2,0,0,0"
                  Command="{Binding OpenGoToLineBarCommand}" ToolTip="转到行 / 列（Ctrl+G）" AutomationProperties.Name="转到行或列" />
          <Button Content="{StaticResource CodiconWordWrap}" FontFamily="{StaticResource IconFontFamily}" Padding="4,1" Margin="2,0,0,0"
                Command="{Binding ToggleWordWrapCommand}" ToolTip="切换自动换行" AutomationProperties.Name="切换自动换行">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding WordWrap}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="{StaticResource CodiconMap}" FontFamily="{StaticResource IconFontFamily}" Padding="4,1" Margin="2,0,0,0"
                  Command="{Binding ToggleShowMinimapCommand}" ToolTip="切换迷你地图" AutomationProperties.Name="切换迷你地图">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ShowMinimap}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button x:Name="OutlineToggleButton" Style="{StaticResource IconButton}"
                  Content="{StaticResource CodiconListTree}" FontFamily="{StaticResource IconFontFamily}"
                  Padding="4,1" Margin="2,0,0,0" IsEnabled="{Binding HasOutline}"
                  Click="ToggleOutline_Click" ToolTip="折叠大纲" AutomationProperties.Name="折叠或展开大纲" />
          <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconCopy}" FontFamily="{StaticResource IconFontFamily}" Padding="4,1" Margin="2,0,0,0"
                  Command="{Binding DataContext.CopySelectedTabPathCommand, RelativeSource={RelativeSource AncestorType=views:EditorAreaView}}"
                  ToolTip="复制文件完整路径" AutomationProperties.Name="复制文件路径" />
          <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconOpenInWindow}" FontFamily="{StaticResource IconFontFamily}" Padding="4,1" Margin="2,0,0,0"
                  Command="{Binding DataContext.OpenInExternalEditorCommand, RelativeSource={RelativeSource AncestorType=views:EditorAreaView}}"
                  CommandParameter="{Binding}" ToolTip="在外部编辑器打开（编辑器命令见设置）" AutomationProperties.Name="在外部编辑器打开" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Find bar → 见编辑区内的浮动 FindWidget(Phase 3:VS Code 风格右上角浮层)。
         Row1 留空,Go-to-line 栏仍在 Row2。 -->

    <!-- Go-to-line bar -->
    <Border Grid.Row="2" Background="{DynamicResource EditorGroupHeaderTabsBackgroundBrush}"
            BorderBrush="{DynamicResource TabBorderBrush}" BorderThickness="0,0,0,1" Padding="12,4"
            Visibility="{Binding IsGoToLineBarOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
      <DockPanel LastChildFill="False" Width="420" HorizontalAlignment="Left">
        <Button DockPanel.Dock="Right" Content="定位" Style="{StaticResource PrimaryButton}" FontSize="{DynamicResource TypeBody}"
                Padding="8,4" Margin="8,0,0,0" Command="{Binding GoToLineCommand}" />
        <TextBlock Text="转到行 / 列：" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource MutedTextBrush}"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="GoToLineBox" Text="{Binding GoToLineInput, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="输入行号，如 42 或 42:16（Enter 定位 · Esc 关闭）" />
      </DockPanel>
    </Border>

    <!-- Read-only code renderer + outline panel + load-issue overlay -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <!-- 大纲不再由内容 Auto 测量；独立列配合 GridSplitter 支持手动调整宽度。 -->
        <ColumnDefinition x:Name="OutlineSplitterColumn" Width="0" />
        <ColumnDefinition x:Name="OutlineColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <!-- Markdown 进入渲染模式即隐藏源码面(不等渲染结果就绪):加载/重载期间显示中性空白,
             避免"源码 + 内置语法高亮"闪帧;解析失败/大型文件切回源码模式时自动恢复显示。 -->
        <Grid x:Name="SourceSurface">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShowSourceSurface}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
        <views:CodeDocumentView x:Name="CodeView" SourceText="{Binding Content}"
                                HighlightingName="{Binding FileType.HighlightingName}"
                                PresentationSnapshot="{Binding Presentation}"
                                EditorFontSize="{Binding FontSize, Mode=TwoWay}"
                                ShowMinimap="{Binding ShowMinimap}"
                                ShowStickyScroll="{Binding ShowStickyScroll}"
                                MinimapRenderCharacters="{Binding MinimapRenderCharacters}"
                                MinimapWidth="{Binding MinimapWidth}"
                                LineNumbersRelative="{Binding LineNumbersRelative}"
                                RulerColumns="{Binding RulerColumns}"
                                ShowLineNumbers="{Binding ShowLineNumbers}"
                                ShowIndentGuides="{Binding ShowIndentGuides}"
                                ShowFoldingControls="{Binding ShowFoldingControls}"
                                CaretLineChanged="CodeView_CaretLineChanged" />
        <Border Background="{DynamicResource EditorBrush}" IsHitTestVisible="False"
                Visibility="{Binding Notice, Converter={StaticResource StringEmptyToCollapsedConverter}}">
          <views:EmptyStateControl Icon="{StaticResource CodiconFile}" Title="{Binding Notice}"
                                   Description="可使用外部编辑器打开该文件。" />
        </Border>
        </Grid>
        <views:MarkdownPreviewView x:Name="MarkdownView" RenderResult="{Binding MarkdownRenderResult}"
                                   LinkRequested="MarkdownView_LinkRequested">
          <views:MarkdownPreviewView.Style>
            <Style TargetType="views:MarkdownPreviewView">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMarkdownRendered}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </views:MarkdownPreviewView.Style>
        </views:MarkdownPreviewView>

        <!-- 浮动查找部件(VS Code findWidget):编辑器区右上角浮层,输入框+计数+上下/全部高亮/关闭,
             选项行(大小写/全词/正则/所选范围)。 -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0" Panel.ZIndex="10"
                Background="{DynamicResource ToolTipBackgroundBrush}" BorderBrush="{DynamicResource ToolTipBorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Effect="{StaticResource ShadowPopupEffect}"
                Padding="8,4"
                Visibility="{Binding IsFindBarOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="FindBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="查找（Enter 下一个 · Shift+Enter 上一个 · Esc 关闭）" MinWidth="200" />
              <TextBlock Text="{Binding CurrentMatchDisplay}" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource MutedTextBrush}"
                         VerticalAlignment="Center" Margin="8,0" MinWidth="44" TextAlignment="Right" />
              <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconArrowUp}" FontFamily="{StaticResource IconFontFamily}" Padding="4,2" Margin="0"
                      Command="{Binding FindPreviousCommand}" ToolTip="上一个匹配（Shift+F3）" />
              <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconArrowDown}" FontFamily="{StaticResource IconFontFamily}" Padding="4,2" Margin="2,0,0,0"
                      Command="{Binding FindNextCommand}" ToolTip="下一个匹配（F3 / Enter）" />
              <Button Content="{StaticResource CodiconSearch}" FontFamily="{StaticResource IconFontFamily}" Padding="4,2" Margin="2,0,0,0"
                      Command="{Binding ToggleHighlightAllCommand}" ToolTip="全部高亮" AutomationProperties.Name="全部高亮">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowAllHighlights}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource ActiveGlyphBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconClose}" FontFamily="{StaticResource IconFontFamily}" Padding="4,2" Margin="2,0,0,0"
                      Command="{Binding ClearSearchCommand}" ToolTip="关闭查找（Esc）" />
            </StackPanel>
            <!-- 正则表达式非法时显示错误(VS Code 同款红字),输入修正后自动消失。 -->
            <TextBlock Text="{Binding SearchErrorMessage}" FontSize="{DynamicResource TypeBody}"
                       Foreground="{DynamicResource ErrorTextBrush}" TextTrimming="CharacterEllipsis"
                       MaxWidth="340" Margin="0,4,0,0" ToolTip="{Binding SearchErrorMessage}"
                       Visibility="{Binding SearchErrorMessage, Converter={StaticResource StringEmptyToCollapsedConverter}}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <CheckBox Content="大小写" FontSize="{DynamicResource TypeBody}" IsChecked="{Binding SearchCaseSensitive, UpdateSourceTrigger=PropertyChanged}" />
              <CheckBox Content="全词" FontSize="{DynamicResource TypeBody}" IsChecked="{Binding SearchWholeWord, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" />
              <CheckBox Content="正则" FontSize="{DynamicResource TypeBody}" IsChecked="{Binding SearchUseRegex, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" />
              <CheckBox Content="所选范围" FontSize="{DynamicResource TypeBody}" IsChecked="{Binding SearchInSelection, UpdateSourceTrigger=PropertyChanged}"
                        Margin="8,0,0,0"
                        Visibility="{Binding HasTextSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Outline sash: direct child of the host Grid so dragging cannot be swallowed by the
           outline Border; Thumb applies the width change explicitly in DragDelta. -->
      <Thumb x:Name="OutlineSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
             Cursor="SizeWE" Visibility="{Binding HasOutline, Converter={StaticResource BooleanToVisibilityConverter}}"
             DragDelta="OutlineSplitter_DragDelta" DragCompleted="OutlineSplitter_DragCompleted">
        <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{DynamicResource BorderBrush}">
              <Border x:Name="HoverLine" Width="1" HorizontalAlignment="Center"
                      Background="{DynamicResource DiffEditorSashBrush}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverLine" Property="Background" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>

      <!-- Symbol outline: only shown when the file has one; a blank sidebar never renders. -->
      <Border Grid.Column="2" Background="{DynamicResource SideBarBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
              Visibility="{Binding HasOutline, Converter={StaticResource BooleanToVisibilityConverter}}"
              MinWidth="190" MaxWidth="320">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="12,8,12,4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding OutlineEntries.Count}" FontSize="{DynamicResource TypeBody}"
                       Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="大纲" Style="{StaticResource SideBarTitleTextStyle}" />
          </DockPanel>
          <TextBox Grid.Row="1" Margin="12,0,12,8" Text="{Binding OutlineFilterText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="筛选符号" />
          <TreeView Grid.Row="2" ItemsSource="{Binding FilteredSymbolRoots}" Background="Transparent" BorderThickness="0"
                    KeyboardNavigation.TabNavigation="None">
            <!-- JumpToOutlineCommand remains the compatibility command for the quick symbol picker;
                 tree nodes use JumpToSymbolCommand so they can navigate to SelectionRange columns. -->
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding VisibleChildren}">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Margin="0" Padding="4,3" MinHeight="0"
                        Command="{Binding DataContext.JumpToSymbolCommand, RelativeSource={RelativeSource AncestorType=views:FilePreviewView}}"
                        CommandParameter="{Binding}" ToolTip="{Binding Signature}">
                  <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource TypeBody}"
                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Range.StartLine}" FontSize="{DynamicResource TypeBody}"
                               Foreground="{DynamicResource SubtleTextBrush}" Margin="8,0,0,0" />
                  </Grid>
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                      <Setter Property="Opacity" Value="1" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="Opacity" Value="0.75" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>
    </Grid>

    <!-- 只读状态(位置/语言/编码/行尾/行数/大小/自动换行)已并入窗口主状态栏(MainWindow 底部
         StatusBar 的"当前文档状态"段),视图内不再保留独立底栏。 -->
  </Grid>
</UserControl>
