<UserControl x:Class="Nornia.Desktop.Views.CodeDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:av="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:views="clr-namespace:Nornia.Desktop.Views">
  <!-- Read-only code renderer built on AvalonEdit (MIT). The view maps ViewModel state (text,
       language highlighting, display options) onto the editor and applies theme tokens in code
       (AvalonEdit's rendering surfaces are not all dependency properties). -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <av:TextEditor x:Name="CodeEditor"
                   IsReadOnly="True"
                   FontFamily="{Binding FontFamily}"
                   Background="{DynamicResource EditorBrush}"
                   Foreground="{DynamicResource TextBrush}"
                   LineNumbersForeground="{DynamicResource CodeLineNumberBrush}"
                   Padding="8,4,8,4"
                   TextOptions.TextFormattingMode="Display"
                   TextOptions.TextRenderingMode="ClearType"
                   UseLayoutRounding="True"
                   ShowLineNumbers="True"
                   WordWrap="False"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto">
      <av:TextEditor.ContextMenu>
        <ContextMenu>
          <MenuItem Header="复制" Command="ApplicationCommands.Copy" />
          <MenuItem Header="全选" Command="ApplicationCommands.SelectAll" />
        </ContextMenu>
      </av:TextEditor.ContextMenu>
      <av:TextEditor.Options>
        <av:TextEditorOptions HighlightCurrentLine="True"
                              EnableHyperlinks="False"
                              EnableEmailHyperlinks="False"
                              ConvertTabsToSpaces="False"
                              IndentationSize="4" />
      </av:TextEditor.Options>
    </av:TextEditor>

    <!-- VS Code overview ruler: find-match / caret-line markers along the right gutter (never
         hit-testable, sits just left of the slim scrollbar). -->
    <Canvas x:Name="CodeOverviewCanvas" Grid.Column="0" Width="6" HorizontalAlignment="Right"
            Margin="0,0,8,0" IsHitTestVisible="False" ClipToBounds="True" />

    <!-- VS Code sticky scroll:滚动时把覆盖视口顶端的折叠段头钉在编辑器顶部(可点击跳转段首);
         最多堆叠 3 级,由 ShowStickyScroll 控制显隐。 -->
    <Border x:Name="StickyHost" Grid.Column="0" Panel.ZIndex="20" VerticalAlignment="Top" HorizontalAlignment="Stretch"
            Background="{DynamicResource EditorBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Visibility="Collapsed" IsHitTestVisible="True">
      <StackPanel x:Name="StickyRows" />
    </Border>

    <!-- Windowed minimap: scaled read-only miniature around the editor viewport with a draggable
         viewport indicator. Visibility is driven by the ShowMinimap dependency property. -->
    <Border x:Name="MinimapHost" Grid.Column="1" Width="130"
            Background="{DynamicResource CodeMinimapBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
            Visibility="Collapsed">
      <Canvas x:Name="MinimapCanvas" ClipToBounds="True" Background="Transparent" />
    </Border>
  </Grid>
</UserControl>
