<UserControl x:Class="Nornia.Desktop.Views.CacheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nornia.Desktop.Views"
             xmlns:b="clr-namespace:Nornia.Desktop.Behaviors">
  <Grid Style="{StaticResource PageRootStyle}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel LastChildFill="False">
      <StackPanel>
        <TextBlock Text="缓存" Style="{StaticResource PageTitleStyle}" />
      </StackPanel>
      <Button Command="{Binding ScanCommand}" DockPanel.Dock="Right" VerticalAlignment="Center" ToolTip="重新扫描 AppData 中的缓存目录">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Content" Value="扫描缓存" />
              <Style.Triggers>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Content" Value="扫描中…" />
                <Setter Property="IsEnabled" Value="False" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </DockPanel>
    <!-- Filter row -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8" VerticalAlignment="Center">
      <TextBlock Text="类型" VerticalAlignment="Center" Margin="{StaticResource GapLeftSm}" />
      <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter}" Width="110" />
      <TextBlock Text="置信度" VerticalAlignment="Center" Margin="{StaticResource GapLeftMd}" />
      <ComboBox ItemsSource="{Binding ConfidenceFilters}" SelectedItem="{Binding ConfidenceFilter}" Width="100" />
      <TextBlock Text="来源" VerticalAlignment="Center" Margin="{StaticResource GapLeftMd}" />
      <ComboBox ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SourceFilter}" Width="120" />
    </StackPanel>
    <!-- Operation + summary row -->
    <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="False">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="清理所选" Command="{Binding CleanCommand}" Style="{StaticResource DangerButton}" ToolTip="仅删除选中缓存目录的内容；执行前会确认。高置信候选默认选中，“需审查”项默认不选；Cookies、历史记录、Local Storage、数据库与配置目录不会列入候选。" />
        <Button Content="打开目录" Command="{Binding OpenSelectedCommand}" ToolTip="在资源管理器中打开所选目录" />
        <Button Content="清空选择" Command="{Binding ClearSelectionCommand}" />
        <Button Content="选择高置信" Command="{Binding SelectHighConfidenceCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding TotalSizeSummary}" />
        <TextBlock Text="{Binding SelectedSummary}" Foreground="{DynamicResource MutedTextBrush}" Margin="{StaticResource GapLeftSm}" />
      </StackPanel>
    </DockPanel>
    <DataGrid Grid.Row="3" ItemsSource="{Binding PackageSummaries}" SelectedItem="{Binding SelectedPackageSummary}" AlternationCount="2" CanUserSortColumns="True"
              CellStyle="{StaticResource EnvironmentDataGridCellStyle}"
              SelectionMode="Extended" KeyboardNavigation.TabNavigation="None"
              b:MultiSelectorBinding.SelectedItems="{Binding SelectedPackageSummaries}"
              b:ListSelectionBehavior.SelectOnRightClick="True">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="复制选中" Command="{Binding CopySelectedPackageSummariesCommand}" InputGestureText="Ctrl+C" />
          <MenuItem Header="复制全部" Command="{Binding CopyAllPackageSummariesCommand}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding PackageSummaries.Count}" Value="0">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
              </Style.Triggers>
            </Style>
      </DataGrid.Style>
      <DataGrid.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource EnvironmentDataGridTextStyle}" />
      </DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTextColumn Header="软件包" Binding="{Binding PackageName}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="2.5*" />
        <DataGridTextColumn Header="Package ID" Binding="{Binding PackageId}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="1.5*" />
        <DataGridTextColumn Header="来源" Binding="{Binding Provider}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="90" />
        <DataGridTextColumn Header="缓存项" Binding="{Binding CandidateCount}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="70" />
        <DataGridTextColumn Header="可释放空间" Binding="{Binding SizeDisplay}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" SortMemberPath="SizeBytes" Width="100" />
        <DataGridTemplateColumn Header="操作" Width="80">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="清理" Command="{Binding DataContext.CleanPackageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="清理该软件包关联的全部缓存目录内容" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <DataGrid Grid.Row="4" ItemsSource="{Binding FilteredCandidates}" SelectedItem="{Binding SelectedCandidate}" AlternationCount="2" IsReadOnly="False"
              CellStyle="{StaticResource EnvironmentDataGridCellStyle}"
              SelectionMode="Extended" KeyboardNavigation.TabNavigation="None"
              b:MultiSelectorBinding.SelectedItems="{Binding SelectedCandidates}"
              b:ListSelectionBehavior.SelectOnRightClick="True"
              Visibility="{Binding IsCandidateListEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
      <DataGrid.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource EnvironmentDataGridTextStyle}" />
      </DataGrid.Resources>
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="复制选中" Command="{Binding CopySelectedCandidatesCommand}" InputGestureText="Ctrl+C" />
          <MenuItem Header="复制全部" Command="{Binding CopyAllCandidatesCommand}" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="清理" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55" IsReadOnly="False" />
        <DataGridTextColumn Header="置信度" Binding="{Binding Confidence}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="85" IsReadOnly="True" />
        <DataGridTextColumn Header="来源" Binding="{Binding Source}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="120" IsReadOnly="True" />
        <DataGridTextColumn Header="软件包" Binding="{Binding PackageName}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="150" IsReadOnly="True" />
        <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" SortMemberPath="SizeBytes" Width="95" IsReadOnly="True" />
        <DataGridTextColumn Header="用户目录" Binding="{Binding UserDirectoryLabel}" Width="120" IsReadOnly="True">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock" BasedOn="{StaticResource EnvironmentDataGridTextStyle}">
              <Setter Property="ToolTip" Value="{Binding UserDirectory}" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="路径" Binding="{Binding Path}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="*" IsReadOnly="True" />
        <DataGridTextColumn Header="识别说明" Binding="{Binding Reason}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="*" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>
    <Border Background="{DynamicResource EditorBrush}" Grid.Row="4" IsHitTestVisible="False"
            Visibility="{Binding IsCandidateListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
      <views:EmptyStateControl Icon="{StaticResource CodiconSearch}" Title="未发现可管理的缓存目录。" Description="点击“扫描缓存”开始。"
                                 ActionText="扫描缓存" ActionCommand="{Binding ScanCommand}" />
    </Border>
    <TextBlock Grid.Row="5" Margin="0,8,0,0" Text="{Binding CleanupResultSummary}" Foreground="{DynamicResource SuccessBrush}"
               Visibility="{Binding CleanupResultSummary, Converter={StaticResource StringEmptyToCollapsedConverter}}" />
  </Grid>
</UserControl>
