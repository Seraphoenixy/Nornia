<UserControl x:Class="Nornia.Desktop.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:Nornia.Desktop.Views"
  xmlns:local="clr-namespace:Nornia.Desktop.ViewModels"
  xmlns:controls="clr-namespace:Nornia.Desktop.Views.Controls"
  xmlns:b="clr-namespace:Nornia.Desktop.Behaviors">
  <UserControl.Resources>
    <b:DataContextBridge x:Key="WorkspaceVm" Value="{Binding}" />

    <!-- 文件夹和文件名共用 Git 状态着色:无状态时文件夹保留标题色,有状态时由状态类型覆盖。 -->
    <Style x:Key="WorkspaceFileNameStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusLetter}" Value="A"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusLetter}" Value="M"><Setter Property="Foreground" Value="{DynamicResource ScmModifiedBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusLetter}" Value="C"><Setter Property="Foreground" Value="{DynamicResource ScmModifiedBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusLetter}" Value="T"><Setter Property="Foreground" Value="{DynamicResource ScmModifiedBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusLetter}" Value="D"><Setter Property="Foreground" Value="{DynamicResource ScmDeletedBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusLetter}" Value="U"><Setter Property="Foreground" Value="{DynamicResource ScmDeletedBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding StatusLetter}" Value="R"><Setter Property="Foreground" Value="{DynamicResource InfoAccentBrush}" /></DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="WorkspaceFolderNameStyle" TargetType="TextBlock" BasedOn="{StaticResource WorkspaceFileNameStyle}">
      <Setter Property="Foreground" Value="{DynamicResource SideBarSectionHeaderForegroundBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="WorkspaceRowActionStyle" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="FontSize" Value="{DynamicResource IconInline}" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <DataTemplate x:Key="WorkspaceFolderRowTemplate" DataType="{x:Type local:WorkspaceFolderRow}">
      <Grid>
        <controls:SidebarTreeGuideLayer GuideLefts="{Binding AncestorGuideLefts}"
                                        ShowGuides="{Binding DataContext.AreTreeGuidesVisible, RelativeSource={RelativeSource AncestorType=views:WorkspaceView}}" />
        <controls:SidebarRowChrome Margin="0" Indent="{Binding IndentMargin}" ShowExpander="True" ShowGlyph="False"
                                   IsExpanded="{Binding IsExpanded}"
                                   ToggleCommand="{Binding DataContext.ToggleTreeFolderCommand, RelativeSource={RelativeSource AncestorType=views:WorkspaceView}}"
                                   ToggleCommandParameter="{Binding}"
                                   RowCommand="{Binding DataContext.ToggleTreeFolderCommand, RelativeSource={RelativeSource AncestorType=views:WorkspaceView}}"
                                   RowCommandParameter="{Binding}">
          <controls:SidebarRowChrome.MainContent>
            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource WorkspaceFolderNameStyle}" FontSize="{DynamicResource TypeBody}" ToolTip="{Binding Path}" />
          </controls:SidebarRowChrome.MainContent>
          <controls:SidebarRowChrome.TrailingContent>
            <controls:FileChangeStatusIndicator StatusLetter="{Binding StatusLetter}" IsFolderSummary="True" Margin="8,0,8,0" />
          </controls:SidebarRowChrome.TrailingContent>
          <controls:SidebarRowChrome.ContextMenu>
            <ContextMenu DataContext="{Binding Value, Source={StaticResource WorkspaceVm}}">
              <MenuItem Header="复制路径" Command="{Binding CopyPathCommand}" CommandParameter="{Binding PlacementTarget.DataContext.Node, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <MenuItem Header="复制相对路径" Command="{Binding CopyRelativePathCommand}" CommandParameter="{Binding PlacementTarget.DataContext.Node, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <MenuItem Header="在系统资源管理器中显示" Command="{Binding RevealInSystemExplorerCommand}" CommandParameter="{Binding PlacementTarget.DataContext.Node, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <Separator />
              <MenuItem Header="展开全部" Command="{Binding ExpandAllCommand}" CommandParameter="{Binding PlacementTarget.DataContext.Node, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <MenuItem Header="折叠全部" Command="{Binding CollapseAllCommand}" CommandParameter="{Binding PlacementTarget.DataContext.Node, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <Separator /><MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
            </ContextMenu>
          </controls:SidebarRowChrome.ContextMenu>
        </controls:SidebarRowChrome>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WorkspaceFileRowTemplate" DataType="{x:Type local:WorkspaceFileRow}">
      <Grid>
        <controls:SidebarTreeGuideLayer GuideLefts="{Binding AncestorGuideLefts}"
                                        ShowGuides="{Binding DataContext.AreTreeGuidesVisible, RelativeSource={RelativeSource AncestorType=views:WorkspaceView}}" />
        <controls:SidebarRowChrome Indent="{Binding IndentMargin}">
          <controls:SidebarRowChrome.InputBindings>
            <!-- 双击文件行:打开常驻标签(单击开预览,VS Code 语义)。 -->
            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.OpenTreeFilePermanentCommand, RelativeSource={RelativeSource AncestorType=views:WorkspaceView}}" CommandParameter="{Binding}" />
          </controls:SidebarRowChrome.InputBindings>
          <controls:SidebarRowChrome.GlyphContent>
            <controls:SidebarFileTypeBadge Path="{Binding Path}" />
          </controls:SidebarRowChrome.GlyphContent>
          <controls:SidebarRowChrome.MainContent>
            <TextBlock Text="{Binding Name}" Style="{StaticResource WorkspaceFileNameStyle}" ToolTip="{Binding Path}" />
          </controls:SidebarRowChrome.MainContent>
          <controls:SidebarRowChrome.SecondaryContent>
            <Button Content="{StaticResource CodiconDiff}" Style="{StaticResource WorkspaceRowActionStyle}" FontFamily="{StaticResource IconFontFamily}" ToolTip="查看更改" Command="{Binding DataContext.RequestDiffCommand, RelativeSource={RelativeSource AncestorType=views:WorkspaceView}}" CommandParameter="{Binding Node}" Visibility="{Binding StatusLetter, Converter={StaticResource StringEmptyToCollapsedConverter}}" />
          </controls:SidebarRowChrome.SecondaryContent>
          <controls:SidebarRowChrome.TrailingContent>
            <controls:FileChangeStatusIndicator StatusLetter="{Binding StatusLetter}" Margin="8,0,8,0" />
          </controls:SidebarRowChrome.TrailingContent>
          <controls:SidebarRowChrome.ContextMenu>
            <ContextMenu DataContext="{Binding Value, Source={StaticResource WorkspaceVm}}">
              <MenuItem Header="打开文件" Command="{Binding OpenNodeCommand}" CommandParameter="{Binding PlacementTarget.DataContext.Node, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <MenuItem Header="查看更改" Command="{Binding RequestDiffCommand}" CommandParameter="{Binding PlacementTarget.DataContext.Node, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <Separator />
              <MenuItem Header="复制路径" Command="{Binding CopyPathCommand}" CommandParameter="{Binding PlacementTarget.DataContext.Node, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <MenuItem Header="复制相对路径" Command="{Binding CopyRelativePathCommand}" CommandParameter="{Binding PlacementTarget.DataContext.Node, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
              <MenuItem Header="在系统资源管理器中显示" Command="{Binding RevealInSystemExplorerCommand}" CommandParameter="{Binding PlacementTarget.DataContext.Node, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>
          </controls:SidebarRowChrome.ContextMenu>
        </controls:SidebarRowChrome>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <controls:SidebarShell Title="资源管理器">
    <controls:SidebarShell.HeaderActions>
      <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconFolderOpened}" FontFamily="{StaticResource IconFontFamily}" Command="{Binding DataContext.ChooseProjectCommand, RelativeSource={RelativeSource AncestorType=views:ExplorerSidebarView}}" Margin="0" AutomationProperties.Name="打开项目目录" />
    </controls:SidebarShell.HeaderActions>
    <controls:SidebarShell.BodyContent>
      <ListBox ItemsSource="{Binding WorkspaceTreeRows}" SelectedItem="{Binding SelectedTreeRow, Mode=TwoWay}" ItemContainerStyle="{StaticResource SidebarRowItemStyle}" Background="Transparent" BorderThickness="0" Padding="0,8,8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" MouseEnter="WorkspaceRows_MouseEnter" MouseLeave="WorkspaceRows_MouseLeave">
        <ListBox.Resources>
          <DataTemplate DataType="{x:Type local:WorkspaceFolderRow}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource WorkspaceFolderRowTemplate}" /></DataTemplate>
          <DataTemplate DataType="{x:Type local:WorkspaceFileRow}"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource WorkspaceFileRowTemplate}" /></DataTemplate>
        </ListBox.Resources>
      </ListBox>
    </controls:SidebarShell.BodyContent>
  </controls:SidebarShell>
</UserControl>
