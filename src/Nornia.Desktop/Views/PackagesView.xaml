<UserControl x:Class="Nornia.Desktop.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Nornia.Desktop.Behaviors"
             xmlns:views="clr-namespace:Nornia.Desktop.Views">
  <UserControl.Resources>
    <!-- Mode segment (已安装 / 可升级 / 搜索): one shared style, the active segment gets the
         bright foreground + accent underline like the bottom-panel tabs. 分段间不留间隔、固定
         等宽(64px 容纳 3 字标签并留足边距):三个分段贴合呈分段控件外观,而非稀疏的独立 Tab。 -->
    <Style x:Key="ModeSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelTabButton}">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Width" Value="64" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ListMode}" Value="Installed">
          <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ListMode}" Value="Updates">
          <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ListMode}" Value="Search">
          <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid Style="{StaticResource PageRootStyle}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="软件包" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="{Binding LastScanDisplay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource TypeBadge}"
                 TextTrimming="CharacterEllipsis" Visibility="{Binding LastScanDisplay, Converter={StaticResource StringEmptyToCollapsedConverter}}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="{StaticResource InsetCard}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Mode segments (Installed / Updates / Search) -->
          <DockPanel LastChildFill="False">
            <TextBlock Text="{Binding PackageListSummary}" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource TypeBody}" TextTrimming="CharacterEllipsis" Margin="{StaticResource GapLeftSm}" />
            <StackPanel Orientation="Horizontal">
              <Button Content="已安装" Command="{Binding SetInstalledModeCommand}" Style="{StaticResource ModeSegmentButtonStyle}" />
              <Button Content="可升级" Command="{Binding SetUpdatesModeCommand}" Style="{StaticResource ModeSegmentButtonStyle}" />
              <Button Content="搜索" Command="{Binding SetSearchModeCommand}" Style="{StaticResource ModeSegmentButtonStyle}" />
            </StackPanel>
          </DockPanel>

          <!-- Installed toolbar: filter left, batch actions right (wrap at narrow widths) -->
          <Grid Grid.Row="1" Margin="{StaticResource GapVerticalSm}">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ListMode}" Value="Updates"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                  <DataTrigger Binding="{Binding ListMode}" Value="Search"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="筛选" VerticalAlignment="Center" Margin="{StaticResource GapLeftSm}" />
              <TextBox Width="200" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称或 Package ID 筛选当前列表" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Style="{StaticResource ToolbarActionsStyle}">
              <Button Content="卸载所选" Command="{Binding UninstallCommand}" ToolTip="选择已安装软件包后可卸载；执行前会确认" Style="{StaticResource DangerButton}" />
              <Button Content="升级所选" Command="{Binding UpgradeCommand}" ToolTip="选择存在可用更新的软件包后可升级" />
              <Button Content="重新扫描" Command="{Binding ListInstalledCommand}" ToolTip="重新读取本机已安装的软件" />
            </WrapPanel>
          </Grid>

          <!-- Updates toolbar -->
          <Grid Grid.Row="1" Margin="{StaticResource GapVerticalSm}">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ListMode}" Value="Updates"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="筛选" VerticalAlignment="Center" Margin="{StaticResource GapLeftSm}" />
              <TextBox Width="200" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按名称或 Package ID 筛选当前列表" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Style="{StaticResource ToolbarActionsStyle}">
              <Button Content="全部升级" Command="{Binding UpgradeAllCommand}" Style="{StaticResource PrimaryButton}" ToolTip="升级所有存在可用更新的软件包" />
              <Button Content="升级所选" Command="{Binding UpgradeCommand}" ToolTip="选择存在可用更新的软件包后可升级" />
            </WrapPanel>
          </Grid>

          <!-- Search toolbar -->
          <Grid Grid.Row="1" Margin="{StaticResource GapVerticalSm}">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ListMode}" Value="Search"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="搜索" VerticalAlignment="Center" Margin="{StaticResource GapLeftSm}" />
              <TextBox Width="260" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入软件名称或关键词" />
              <Button Content="搜索" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" ToolTip="搜索 Windows Package Manager 软件源" Margin="{StaticResource GapLeftSm}" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Style="{StaticResource ToolbarActionsStyle}">
              <Button Content="安装所选" Command="{Binding InstallSelectedCommand}" Style="{StaticResource PrimaryButton}" ToolTip="选择未安装的搜索结果后可安装" />
              <Button Content="卸载所选" Command="{Binding UninstallCommand}" Style="{StaticResource DangerButton}" ToolTip="选择搜索结果中已安装的软件包后卸载；执行前会确认" />
            </WrapPanel>
          </Grid>

          <!-- Package operation progress: determinate when the package manager emits a percentage,
               otherwise indeterminate while it is resolving metadata or launching an installer. -->
          <Border Grid.Row="2" Margin="{StaticResource GapVerticalSm}" Padding="{StaticResource InsetCompactRow}"
                  Background="{DynamicResource EditorBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="取消" Command="{Binding CancelOperationCommand}" Style="{StaticResource LinkButton}"
                        ToolTip="取消当前软件包操作" />
                <TextBlock Text="{Binding CurrentOperation.Detail}" Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="{DynamicResource TypeBody}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CurrentOperation.ProgressDisplay}" Foreground="{DynamicResource InfoAccentBrush}"
                           FontSize="{DynamicResource TypeBadge}" Margin="{StaticResource GapLeftSm}"
                           Visibility="{Binding CurrentOperation.HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </DockPanel>
              <ProgressBar Grid.Row="1" Height="4" Margin="0,4,0,0" Maximum="100"
                           Value="{Binding CurrentOperation.Progress, TargetNullValue=0}"
                           BorderThickness="0" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource AccentBrush}">
                <ProgressBar.Style>
                  <Style TargetType="ProgressBar">
                    <Setter Property="IsIndeterminate" Value="True" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding CurrentOperation.HasProgress}" Value="True">
                        <Setter Property="IsIndeterminate" Value="False" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ProgressBar.Style>
              </ProgressBar>
            </Grid>
          </Border>

          <!-- Installed / updates grid -->
          <Grid Grid.Row="3">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ListMode}" Value="Search"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <DataGrid ItemsSource="{Binding FilteredPackages}" SelectedItem="{Binding SelectedPackage}" AlternationCount="2" CanUserSortColumns="True"
                      CellStyle="{StaticResource EnvironmentDataGridCellStyle}"
                      SelectionMode="Extended" b:MultiSelectorBinding.SelectedItems="{Binding SelectedPackages}"
                      b:ListSelectionBehavior.SelectOnRightClick="True">
              <DataGrid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource EnvironmentDataGridTextStyle}" />
              </DataGrid.Resources>
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="复制选中" Command="{Binding CopySelectedPackagesCommand}" InputGestureText="Ctrl+C" />
                  <MenuItem Header="复制全部" Command="{Binding CopyAllPackagesCommand}" />
                  <Separator />
                  <MenuItem Header="卸载" Command="{Binding UninstallCommand}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="2*" />
                <DataGridTextColumn Header="已装版本" Binding="{Binding Version}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="130" />
                <DataGridTextColumn Header="可用更新" Binding="{Binding AvailableVersion}" Width="130">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EnvironmentDataGridTextStyle}">
                      <Setter Property="Foreground" Value="{DynamicResource InfoAccentBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding AvailableVersion}" Value="{x:Null}"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></DataTrigger>
                        <DataTrigger Binding="{Binding AvailableVersion}" Value=""><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="架构" Binding="{Binding Architecture}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="90" />
                <DataGridTextColumn Header="来源" Binding="{Binding Provider}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="110"
                                    Visibility="{Binding DataContext.IsProviderColumnVisible, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </DataGrid.Columns>
            </DataGrid>
            <Border Background="{DynamicResource EditorBrush}" Visibility="{Binding IsInstalledListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
              <views:EmptyStateControl Icon="{StaticResource CodiconSearch}" Title="{Binding EmptyStateMessage}" Description="点击“重新扫描”或“搜索”开始。"
                                       ActionText="重新扫描" ActionCommand="{Binding ListInstalledCommand}" />
            </Border>
          </Grid>

          <!-- Search grid -->
          <Grid Grid.Row="3">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ListMode}" Value="Search"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <DataGrid ItemsSource="{Binding SearchView}" SelectedItem="{Binding SelectedPackage}" AlternationCount="2" CanUserSortColumns="True"
                      CellStyle="{StaticResource EnvironmentDataGridCellStyle}"
                      SelectionMode="Extended" b:MultiSelectorBinding.SelectedItems="{Binding SelectedPackages}"
                      b:ListSelectionBehavior.SelectOnRightClick="True">
              <DataGrid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource EnvironmentDataGridTextStyle}" />
              </DataGrid.Resources>
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="复制选中" Command="{Binding CopySelectedPackagesCommand}" InputGestureText="Ctrl+C" />
                  <MenuItem Header="复制全部搜索结果" Command="{Binding CopyAllSearchResultsCommand}" />
                  <Separator />
                  <MenuItem Header="卸载" Command="{Binding UninstallCommand}" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="2*" />
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="2*" />
                <DataGridTextColumn Header="版本" Binding="{Binding Version}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="130" />
                <DataGridTextColumn Header="来源" Binding="{Binding Provider}" ElementStyle="{StaticResource EnvironmentDataGridTextStyle}" Width="110" />
                <DataGridTemplateColumn Header="状态" Width="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadgeStyle}">
                        <TextBlock FontSize="{DynamicResource TypeBody}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EnvironmentDataGridTextStyle}">
                              <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                              <Setter Property="Text" Value="可安装" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                  <Setter Property="Text" Value="已安装" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <Border Background="{DynamicResource EditorBrush}" Visibility="{Binding IsSearchListEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
              <views:EmptyStateControl Icon="{StaticResource CodiconSearch}" Title="{Binding EmptyStateMessage}" Description="检查关键词或换一个词再试。"
                                       ActionText="搜索" ActionCommand="{Binding SearchCommand}" />
            </Border>
          </Grid>

          <!-- Selection summary -->
          <TextBlock Grid.Row="4" Margin="{StaticResource GapSm}" Text="{Binding SelectedPackageSummary}" ToolTip="{Binding SelectedPackageSummary}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SelectionSummaryStyle}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedPackage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
    </Grid>
  </Grid>
</UserControl>
