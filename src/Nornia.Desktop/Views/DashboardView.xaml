<UserControl x:Class="Nornia.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:views="clr-namespace:Nornia.Desktop.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <DockPanel LastChildFill="False">
        <StackPanel>
          <TextBlock Text="任务中心" Style="{StaticResource PageHeroTitleStyle}" />
        </StackPanel>
        <Button Content="刷新状态" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" VerticalAlignment="Center" />
      </DockPanel>

      <Border Style="{StaticResource InfoBannerStyle}" Margin="{StaticResource MarginBanner}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="下一步建议" FontSize="{DynamicResource TypeHeading}" Foreground="{DynamicResource InfoAccentBrush}" />
            <TextBlock Text="{Binding NextStepTitle}" Style="{StaticResource PageHeroTitleStyle}" Margin="{StaticResource GapXs}" />
            <TextBlock Text="{Binding NextStepDescription}" Foreground="{DynamicResource TextBrush}" Margin="{StaticResource GapXs}" TextWrapping="Wrap" />
          </StackPanel>
          <!-- The action row drops below the text and wraps instead of squeezing the banner at
               narrow widths, so the primary action always stays reachable. -->
          <WrapPanel Grid.Row="1" Margin="{StaticResource GapMd}" HorizontalAlignment="Right">
            <Button Content="扫描环境" Command="{Binding ScanEnvironmentCommand}" />
            <Button Content="检查项目" Command="{Binding CheckProjectsCommand}" />
            <Button Content="查看修复计划" Command="{Binding ViewRepairPlanCommand}" Style="{StaticResource PrimaryButton}" />
          </WrapPanel>
        </Grid>
      </Border>

      <!-- Metric cards reflow by available width (fixed card width, wrap panel): four up in the
           default window, two/three once the sidebar opens or the window narrows to 1100px. -->
      <WrapPanel Margin="{StaticResource GapBottomSm}">
        <Border Style="{StaticResource MetricCardStyle}" Width="230" Margin="{StaticResource MarginCard}">
          <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Bottom" Content="查看详情" Command="{Binding GoToRuntimeDetailsCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Padding="0" Margin="{StaticResource GapSm}" />
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="运行库 / 工具" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Text="{Binding InstalledRuntimeCount}" FontSize="{DynamicResource TypeHero}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding InstalledToolCount, StringFormat=工具 {0} 项}" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource MetricCardStyle}" Width="230" Margin="{StaticResource MarginCard}">
          <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Bottom" Content="查看详情" Command="{Binding GoToProjectIssuesCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Padding="0" Margin="{StaticResource GapSm}" />
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="项目" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Text="{Binding ProjectCount}" FontSize="{DynamicResource TypeHero}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding EnvironmentIssueCount, StringFormat=需处理 {0} 项}" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource MetricCardStyle}" Width="230" Margin="{StaticResource MarginCard}">
          <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Bottom" Content="查看详情" Command="{Binding GoToPackageUpdatesCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Padding="0" Margin="{StaticResource GapSm}" />
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="可用更新" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Text="{Binding AvailableUpdateCount}" FontSize="{DynamicResource TypeHero}" FontWeight="SemiBold" />
              <TextBlock Text="在待办中处理" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource MetricCardStyle}" Width="230" Margin="{StaticResource MarginCard}">
          <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Bottom" Content="查看详情" Command="{Binding GoToCacheCandidatesCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Padding="0" Margin="{StaticResource GapSm}" />
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="高置信缓存" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Text="{Binding ReclaimableCacheSize}" FontSize="{DynamicResource TypeHero}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CacheCandidateSummary}" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </WrapPanel>

      <StackPanel>
        <TextBlock Text="待办事项" Style="{StaticResource SectionHeaderStyle}" Margin="{StaticResource GapBottomSm}" />
        <ItemsControl ItemsSource="{Binding Tasks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ListItemButtonStyle}" HorizontalContentAlignment="Stretch" Margin="{StaticResource GapBottomSm}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedTextBrush}" Margin="{StaticResource GapXs}" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="1" Text="{StaticResource CodiconChevronRight}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}" VerticalAlignment="Center" Margin="{StaticResource GapLeftLg}" /></Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <views:EmptyStateControl Icon="{StaticResource CodiconDashboard}" Title="没有待处理事项。" Description="你可以刷新状态或进入专业页面继续管理。" Visibility="{Binding HasTasks, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Margin="{StaticResource GapVerticalSm}"
                  ActionText="刷新状态" ActionCommand="{Binding RefreshCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
