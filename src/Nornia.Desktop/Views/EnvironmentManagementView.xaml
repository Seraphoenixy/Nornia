<UserControl x:Class="Nornia.Desktop.Views.EnvironmentManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Nornia.Desktop.ViewModels" xmlns:views="clr-namespace:Nornia.Desktop.Views">
  <UserControl.Resources>
    <!-- 环境管理的 Runtime/工具/包/缓存页面复用同一表格单元格样式：固定行高下文本
         必须垂直居中，不能沿用 WPF DataGridCell 默认的顶部内容对齐。 -->
    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate><DataTemplate DataType="{x:Type vm:RuntimeViewModel}"><views:RuntimeView/></DataTemplate><DataTemplate DataType="{x:Type vm:ToolsViewModel}"><views:ToolsView/></DataTemplate><DataTemplate DataType="{x:Type vm:PackagesViewModel}"><views:PackagesView/></DataTemplate><DataTemplate DataType="{x:Type vm:CacheViewModel}"><views:CacheView/></DataTemplate>
  </UserControl.Resources>
  <ContentControl Content="{Binding CurrentPage}" Margin="{StaticResource InsetPage}"/>
</UserControl>
