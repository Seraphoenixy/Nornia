<UserControl x:Class="Nornia.Desktop.Views.EditorGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nornia.Desktop.ViewModels"
             xmlns:views="clr-namespace:Nornia.Desktop.Views"
             xmlns:loc="clr-namespace:Nornia.Desktop.Localization">
  <UserControl.Resources>
    <!-- 页面标签条项:内容页(环境管理 / 项目管理 / 设置)全局标签,不进入任何编辑器组。 -->
    <Style x:Key="PageTabItemStyle" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Height="{DynamicResource SizeTabBar}">
              <Grid.RowDefinitions><RowDefinition Height="2" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Border x:Name="ActiveTop" Grid.Row="0" Background="Transparent" />
              <Border x:Name="TabBorder" Grid.Row="1" Background="{TemplateBinding Background}"
                      BorderBrush="{DynamicResource TabBorderBrush}" BorderThickness="0,0,1,0"
                      Padding="12,0,6,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource IconFontFamily}"
                             FontSize="{DynamicResource IconInline}" Foreground="{DynamicResource NavGlyphBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock x:Name="PageTitle" Grid.Column="1" Text="{Binding Title}" FontSize="{DynamicResource TypeBody}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource MutedTextBrush}" />
                  <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButton}"
                          Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0" Margin="6,0,0,0"
                          Visibility="Visible" Click="TabCloseButton_Click"
                          ToolTip="{loc:StringLoc Key=CloseTab}" AutomationProperties.Name="关闭页面标签">
                    <TextBlock Text="{StaticResource CodiconClose}" FontFamily="{StaticResource IconFontFamily}"
                               FontSize="{DynamicResource IconInline}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Button>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ActiveTop" Property="Background" Value="{DynamicResource TabActiveBorderTopBrush}" />
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
                <Setter TargetName="PageTitle" Property="Foreground" Value="{DynamicResource TabActiveForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsMouseCaptured" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 一级工作台标签条:页面与文件/Diff 标签共用一条,顺序由 Workbench.Tabs 保持。 -->
    <Style x:Key="UnifiedTabItemStyle" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Height="{DynamicResource SizeTabBar}">
              <Grid.RowDefinitions><RowDefinition Height="2" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Border x:Name="ActiveTop" Grid.Row="0" Background="Transparent" />
              <Border x:Name="TabBorder" Grid.Row="1" Background="{TemplateBinding Background}"
                      BorderBrush="{DynamicResource TabBorderBrush}" BorderThickness="0,0,1,0"
                      Padding="12,0,10,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Viewbox x:Name="TabBadge" Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly"
                           Width="{DynamicResource IconMonogramSlot}" Height="{DynamicResource IconMonogramCell}"
                           Margin="0,0,4,0" ClipToBounds="True">
                    <TextBlock Text="{Binding FileType.IconMonogram}"
                               Style="{StaticResource FileTypeMonogramTextStyle}" Width="Auto" Margin="0"
                               Foreground="{Binding FileType, Converter={StaticResource FileTypeToBrushConverter}}" />
                  </Viewbox>
                  <TextBlock x:Name="TabGlyph" Grid.Column="0" Text="{Binding Glyph}"
                             FontFamily="{StaticResource IconFontFamily}"
                             FontSize="{DynamicResource IconInline}" Foreground="{DynamicResource NavGlyphBrush}"
                             Width="24" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"
                             Visibility="Collapsed" />
                  <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}"
                             FontSize="{DynamicResource TypeBody}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}"
                             ToolTip="{Binding ToolTipText}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid x:Name="DiffStatus" Width="{DynamicResource IconMonogramSlot}"
                          Height="{DynamicResource IconMonogramCell}" VerticalAlignment="Center"
                          Margin="0,0,4,0" Visibility="Collapsed">
                      <TextBlock Text="{Binding DiffStatusMarker}"
                                 FontWeight="Bold" FontSize="{DynamicResource TypeBody}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 TextAlignment="Center"
                                 Foreground="{Binding DiffStatus, Converter={StaticResource DiffTabStatusToBrushConverter}}"
                                 ToolTip="{Binding DiffStatusToolTip}" />
                    </Grid>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="20" Height="20"
                            MinWidth="0" MinHeight="0" Padding="0" Margin="8,0,0,0"
                            Visibility="Visible" Click="TabCloseButton_Click"
                            ToolTip="{loc:StringLoc Key=CloseTab}" AutomationProperties.Name="关闭标签">
                      <TextBlock Text="{StaticResource CodiconClose}" FontFamily="{StaticResource IconFontFamily}"
                                 FontSize="{DynamicResource IconInline}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="UnpinButton" Style="{StaticResource IconButton}" Width="20" Height="20"
                            MinWidth="0" MinHeight="0" Padding="0" Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" ToolTip="取消固定" AutomationProperties.Name="取消固定标签">
                      <TextBlock Text="{StaticResource CodiconPin}" FontFamily="{StaticResource IconFontFamily}"
                                 FontSize="{DynamicResource IconInline}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ActiveTop" Property="Background" Value="{DynamicResource TabActiveBorderTopBrush}" />
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TabActiveForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsMouseCaptured" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PressedBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding FileType}" Value="{x:Null}">
                <Setter TargetName="TabBadge" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TabGlyph" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsDiff}" Value="True">
                <Setter TargetName="DiffStatus" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <!-- Diff 标签选中态与资源管理器树的键盘焦点选中行保持同一层次。 -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsDiff}" Value="True" />
                  <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectionActiveBrush}" />
              </MultiDataTrigger>
              <!-- Diff 标签标题沿用资源管理器的 SCM 语义色:新增/暂存绿色,未暂存黄色,
                   提交来源蓝色;选中状态也保留类型提示。 -->
              <DataTrigger Binding="{Binding DiffStatus}" Value="{x:Static vm:DiffTabStatus.Staged}">
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding DiffStatus}" Value="{x:Static vm:DiffTabStatus.Untracked}">
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding DiffStatus}" Value="{x:Static vm:DiffTabStatus.Modified}">
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource ScmModifiedBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding DiffStatus}" Value="{x:Static vm:DiffTabStatus.Commit}">
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource InfoAccentBrush}" />
              </DataTrigger>
              <!-- VS Code 预览标签:标题轻微倾斜(预览状态由 EditorTabItem.IsPreview 镜像到工作台标签)。
                   用小幅 SkewTransform 代替字体真斜体——真斜体斜度(≈12°)太陡,8° 更柔和且仍可辨识。 -->
              <DataTrigger Binding="{Binding IsPreview}" Value="True">
                <Setter TargetName="TitleText" Property="RenderTransform">
                  <Setter.Value>
                    <SkewTransform AngleX="-8" />
                  </Setter.Value>
                </Setter>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsPinned}" Value="True">
                <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="UnpinButton" Property="Visibility" Value="Visible" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 组间分割线:悬停/键盘焦点高亮 + 键盘焦点环(VS Code Sash)。 -->
    <Style x:Key="GroupSplitterStyle" TargetType="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 唯一一级标签条:页面与文件/Diff 标签均从 Workbench.Tabs 渲染。 -->
    <Border Grid.Row="0" Background="{DynamicResource EditorGroupHeaderTabsBackgroundBrush}"
            BorderBrush="{DynamicResource TabBorderBrush}" BorderThickness="0,0,0,1"
            Visibility="{Binding HasTabs, Converter={StaticResource BooleanToVisibilityConverter}}">
      <ListBox x:Name="EditorTabList" ItemsSource="{Binding Tabs}"
               SelectedItem="{Binding SelectedTab, Mode=TwoWay}" SelectionMode="Single"
               AllowDrop="True" Background="Transparent" BorderThickness="0"
               Height="{DynamicResource SizeTabBar}" VerticalContentAlignment="Stretch"
               PreviewMouseLeftButtonDown="EditorTabList_PreviewMouseLeftButtonDown"
               PreviewMouseMove="EditorTabList_PreviewMouseMove"
               PreviewMouseDown="EditorTabList_PreviewMouseDown"
               PreviewMouseRightButtonDown="EditorTabList_PreviewMouseRightButtonDown"
               ContextMenuOpening="EditorTabList_ContextMenuOpening"
               ContextMenuClosing="EditorTabList_ContextMenuClosing"
               DragOver="EditorTabList_DragOver"
               Drop="EditorTabList_Drop" MouseDoubleClick="EditorTabList_MouseDoubleClick"
               ItemContainerStyle="{StaticResource UnifiedTabItemStyle}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ContextMenu>
          <!-- Tag is populated from the item that actually opened the menu. Do not use
               PlacementTarget.SelectedItem here: WPF can open the menu before the binding
               projection has observed a right-click selection change. -->
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="向右拆分" Command="{Binding SplitEditorTabRightCommand}"
                      CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="向下拆分" Command="{Binding SplitEditorTabDownCommand}"
                      CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="固定标签" Command="{Binding TogglePinCommand}"
                      CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding Tag.IsPinned, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            <MenuItem Header="取消固定" Command="{Binding TogglePinCommand}"
                      CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Visibility="{Binding Tag.IsPinned, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Separator />
            <MenuItem Header="复制路径" Command="{Binding CopyTabPathCommand}"
                      CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="在资源管理器中显示" Command="{Binding RevealEditorTabCommand}"
                      CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="用外部编辑器打开" Command="{Binding OpenEditorTabExternallyCommand}"
                      CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="关闭" Command="{Binding CloseTabCommand}"
                      CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+W" />
            <MenuItem Header="关闭其他" Command="{Binding CloseOtherTabsCommand}"
                      CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="关闭右侧" Command="{Binding CloseTabsToTheRightCommand}"
                      CommandParameter="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="关闭全部" Command="{Binding CloseAllTabsCommand}" />
          </ContextMenu>
        </ListBox.ContextMenu>
      </ListBox>
    </Border>

    <!-- 内容区:选中页面标签 → 页面内容全区域;文档/空选择 → 编辑器组网格。 -->
    <Grid Grid.Row="1">
      <ContentControl Content="{Binding SelectedPageContent}"
                      Visibility="{Binding IsPageTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <Border x:Name="GroupsHost" Background="{DynamicResource EditorBrush}"
              Visibility="{Binding IsPageTabSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
    </Grid>
  </Grid>
</UserControl>
