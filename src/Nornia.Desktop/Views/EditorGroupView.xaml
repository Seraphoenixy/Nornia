<UserControl x:Class="Nornia.Desktop.Views.EditorGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:Nornia.Desktop.Behaviors"
             xmlns:vm="clr-namespace:Nornia.Desktop.ViewModels"
             xmlns:views="clr-namespace:Nornia.Desktop.Views"
             xmlns:loc="clr-namespace:Nornia.Desktop.Localization">
  <UserControl.Resources>
    <Style x:Key="GroupTabCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource BrightTextBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource DangerPressedBrush}" />
          <Setter Property="BorderBrush" Value="Transparent" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- VS Code 风格组标签条项:文件标签 Monogram / diff 字形 / 预览斜体 / 悬停关闭。 -->
    <Style x:Key="GroupTabItemStyle" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Height="{DynamicResource SizeTabBar}">
              <Grid.RowDefinitions><RowDefinition Height="2" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Border x:Name="ActiveTop" Grid.Row="0" Background="Transparent" />
              <Border x:Name="TabBorder" Grid.Row="1" Background="{TemplateBinding Background}"
                      BorderBrush="{DynamicResource TabBorderBrush}" BorderThickness="0,0,1,0"
                      Padding="12,0,10,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Viewbox x:Name="TabBadge" Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly"
                           Width="{DynamicResource IconMonogramSlot}" Height="{DynamicResource IconMonogramCell}"
                           Margin="0,0,4,0" ClipToBounds="True">
                    <TextBlock Text="{Binding FileType.IconMonogram}"
                               Style="{StaticResource FileTypeMonogramTextStyle}" Width="Auto" Margin="0"
                               Foreground="{Binding FileType, Converter={StaticResource FileTypeToBrushConverter}}" />
                  </Viewbox>
                  <TextBlock x:Name="TabGlyph" Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource IconFontFamily}"
                             FontSize="{DynamicResource IconInline}" Foreground="{DynamicResource NavGlyphBrush}"
                             Width="24" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                  <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource TypeBody}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource MutedTextBrush}" ToolTip="{Binding Path}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid x:Name="DiffStatus" Width="{DynamicResource IconMonogramSlot}"
                          Height="{DynamicResource IconMonogramCell}" VerticalAlignment="Center"
                          Margin="0,0,4,0" Visibility="Collapsed">
                      <TextBlock Text="{Binding TabStatusMarker}"
                                 FontWeight="Bold" FontSize="{DynamicResource TypeBody}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 TextAlignment="Center"
                                 Foreground="{Binding TabStatus, Converter={StaticResource DiffTabStatusToBrushConverter}}"
                                 ToolTip="{Binding TabStatusToolTip}" />
                    </Grid>
                    <!-- 固定标签标记(VS Code pinned tabs:固定宽、钉在条带左端、不参与左端滚动)。 -->
                    <TextBlock Text="{StaticResource CodiconPin}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="已固定"
                               Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="CloseButton" Style="{StaticResource GroupTabCloseButtonStyle}"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="{loc:StringLoc Key=CloseTab}"
                            AutomationProperties.Name="关闭标签">
                      <TextBlock Text="{StaticResource CodiconClose}" FontFamily="{StaticResource IconFontFamily}"
                                 FontSize="{DynamicResource IconInline}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
                <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ActiveTop" Property="Background" Value="{DynamicResource TabActiveBorderTopBrush}" />
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TabActiveForegroundBrush}" />
                <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseCaptured" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PressedBrush}" />
              </Trigger>
              <!-- 预览标签:斜体标题 (VS Code preview)。 -->
              <!-- 无 FileType 的标签(如 diff 标签):隐藏语言缩写,显示字形回退。 -->
              <DataTrigger Binding="{Binding FileType}" Value="{x:Null}">
                <Setter TargetName="TabBadge" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="TabGlyph" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsDiff}" Value="True">
                <Setter TargetName="DiffStatus" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsDiff}" Value="True" />
                  <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectionActiveBrush}" />
              </MultiDataTrigger>
              <DataTrigger Binding="{Binding TabStatus}" Value="{x:Static vm:DiffTabStatus.Staged}">
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding TabStatus}" Value="{x:Static vm:DiffTabStatus.Untracked}">
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding TabStatus}" Value="{x:Static vm:DiffTabStatus.Modified}">
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource ScmModifiedBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding TabStatus}" Value="{x:Static vm:DiffTabStatus.Commit}">
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource InfoAccentBrush}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- 组根:活动组边框 + 拖拽放置区(中央 = 移动标签;上下左右边缘 = 拆分并移动)。 -->
  <Border x:Name="GroupRoot" Background="{DynamicResource EditorBrush}"
          BorderBrush="Transparent" BorderThickness="1"
          AllowDrop="True"
          PreviewMouseLeftButtonDown="GroupRoot_PreviewMouseLeftButtonDown"
          DragOver="GroupRoot_DragOver" DragLeave="GroupRoot_DragLeave" Drop="GroupRoot_Drop">
    <Border.Style>
      <Style TargetType="Border">
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsActive}" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource EditorGroupActiveBorderBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <!-- 组内容:当前标签(EditorAreaView 提供文件预览 / diff 模板)或空态。 -->
      <Grid>
        <views:EditorAreaView />
        <views:EmptyStateControl Visibility="{Binding Tabs.Count, Converter={StaticResource CountToVisibilityConverter}}"
                                 Icon="{StaticResource CodiconEmptyWindow}" Title="{loc:StringLoc Key=Empty_NoTabs_Title}"
                                 Description="{loc:StringLoc Key=Empty_NoTabs_Description}" />
      </Grid>

      <!-- 拆分拖拽提示层:中央移动 / 上下左右边缘拆分,命中区高亮。 -->
      <Grid x:Name="DropOverlay" IsHitTestVisible="False" Visibility="Collapsed" Background="Transparent">
        <Border x:Name="DropZoneCenter" Background="{DynamicResource DropZoneHighlightBrush}" CornerRadius="{StaticResource RadiusSm}" Margin="16" Visibility="Collapsed" />
        <Border x:Name="DropZoneLeft" Background="{DynamicResource DropZoneHighlightBrush}" CornerRadius="{StaticResource RadiusSm}"
                HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="96" Margin="8" Visibility="Collapsed" />
        <Border x:Name="DropZoneRight" Background="{DynamicResource DropZoneHighlightBrush}" CornerRadius="{StaticResource RadiusSm}"
                HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="96" Margin="8" Visibility="Collapsed" />
        <Border x:Name="DropZoneTop" Background="{DynamicResource DropZoneHighlightBrush}" CornerRadius="{StaticResource RadiusSm}"
                HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="64" Margin="8" Visibility="Collapsed" />
        <Border x:Name="DropZoneBottom" Background="{DynamicResource DropZoneHighlightBrush}" CornerRadius="{StaticResource RadiusSm}"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="64" Margin="8" Visibility="Collapsed" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
