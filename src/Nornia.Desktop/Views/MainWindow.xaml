<Window x:Class="Nornia.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:Nornia.Desktop.Behaviors"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:vm="clr-namespace:Nornia.Desktop.ViewModels"
        xmlns:services="clr-namespace:Nornia.Desktop.Services"
        xmlns:loc="clr-namespace:Nornia.Desktop.Localization"
        xmlns:views="clr-namespace:Nornia.Desktop.Views"
        Title="Nornia" Width="1360" Height="820" MinWidth="960" MinHeight="680"
        Icon="/Nornia.Desktop;component/Assets/app.ico"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" ShowActivated="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown" DpiChanged="MainWindow_DpiChanged">

  <Window.Resources>
    <!-- Main content templates (the page itself; its secondary sidebar is rendered in the sidebar column) -->
    <DataTemplate DataType="{x:Type vm:EnvironmentManagementViewModel}"><views:EnvironmentManagementView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ExplorerPageViewModel}"><views:ExplorerPageView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:GitViewModel}"><views:GitPageView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProjectsViewModel}"><views:ProjectsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>

    <!-- VS Code Dark Modern activity bar: translucent active/hover backgrounds, inactive icon dimming -->
    <Style x:Key="ActivityItemStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource ActivityBarInactiveForegroundBrush}" />
      <!-- 活动栏项固定正方形,随 SizeActivity 令牌缩放(48px — VS Code 默认桌面密度) -->
      <Setter Property="Width" Value="{DynamicResource SizeActivity}" />
      <Setter Property="Height" Value="{DynamicResource SizeActivity}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid x:Name="ActivityItem" Background="Transparent">
              <!-- 呈现器拉伸铺满按钮:徽标的 Right/Bottom 锚定才算数的按钮角落,
                   居中呈现时徽标只能贴在收缩后的内容格上(视觉上落在按钮中部)。 -->
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ActivityItem" Property="Background" Value="{DynamicResource ActivityBarHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ActivityBarForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ActivityItem" Property="Background" Value="{DynamicResource ActivityBarActiveBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ActivityBarForegroundBrush}" />
              </Trigger>
              <!-- pressed: immediate feedback while the mouse is down on the item -->
              <Trigger Property="IsMouseCaptured" Value="True">
                <Setter TargetName="ActivityItem" Property="Background" Value="{DynamicResource PressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding DataContext.IsCompactActivityBar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="Width" Value="{DynamicResource SizeActivityCompact}" />
          <Setter Property="Height" Value="{DynamicResource SizeActivityActionCompact}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  <!-- 顶栏右侧布局切换按钮样式: 紧凑无边框图标按钮, 激活态(侧栏实际可见 / 底栏展开)
         字形高亮走 ActiveGlyphBrush, 悬停/按下/禁用态由 TitleBarIconButton 提供。
         侧栏按钮跟随 IsSidebarColumnVisible(响应式自动收起时侧栏实际隐藏,按钮不点亮)。 -->
    <Style x:Key="TitleBarSidebarToggleButton" TargetType="Button" BasedOn="{StaticResource TitleBarIconButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSidebarColumnVisible}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource ActiveGlyphBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TitleBarPanelToggleButton" TargetType="Button" BasedOn="{StaticResource TitleBarIconButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPanelExpanded}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource ActiveGlyphBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- VS Code command center: the title-bar entry opens the same command palette as
         Ctrl+Shift+P. Keep its width in sync with the overlay and use a bounded radius;
         RadiusPill can render as a spindle when the caption is resized or DPI-scaled. -->
    <Style x:Key="TitleBarCommandCenterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="{DynamicResource SizeCommandPalette}" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Padding" Value="10,0,12,0" />
      <Setter Property="Background" Value="{DynamicResource TitleBarCommandCenterBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CommandCenter" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PressedBorderBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <!-- 标题栏行随 UI 字号缩放:Auto 行 + 栏自身 Height=SizeTitleBar 令牌。注意 DynamicResource
           解析出的是 double 值,无法直接赋给 GridLength 类型的 RowDefinition.Height(运行期抛
           "'35'不是属性'Height'的有效值"),因此高度令牌落在栏 Border 上,行按内容自适应。 -->
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <!-- Status bar row rides the font scale: Auto height + MinHeight token on the bar itself — VS Code 22px. -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- VS Code-style title bar: Logo + 完整菜单 | 返回/前进 + 工作区命令中心 | 布局切换 + 窗口控制。
         拖动/双击最大化经 Border 的 MouseLeftButtonDown 处理(按钮自身消费点击,不影响拖动)。 -->
    <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Height="{DynamicResource SizeTitleBar}"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- 左侧品牌区与菜单位于 WindowChrome 的标题栏高度内,显式标记为可命中,
             避免被系统双击/拖动区域当作非客户区拦截。 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Image Width="18" Height="18" Stretch="Uniform" SnapsToDevicePixels="True"
                 Source="/Nornia.Desktop;component/Assets/app.ico" />
        </StackPanel>

        <!-- VS Code menu bar embedded in the title strip: 文件/编辑/选择/查看/转到/运行/终端/帮助 -->
        <Menu Grid.Column="1" Style="{StaticResource TitleBarMenuStyle}" VerticalAlignment="Center"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              PreviewKeyDown="MainWindow_PreviewKeyDown">
          <MenuItem Header="文件" Style="{StaticResource TitleBarMenuItemStyle}">
            <MenuItem Header="打开项目目录…" Command="{Binding Commands[nornia.project.open]}" />
            <MenuItem Header="快速打开…" Command="{Binding Commands[workbench.action.quickOpen]}" InputGestureText="Ctrl+P" />
            <Separator />
            <MenuItem Header="打开设置" Command="{Binding Commands[workbench.action.openSettings]}" InputGestureText="Ctrl+," />
            <MenuItem Header="打开键盘快捷方式" Command="{Binding Commands[workbench.action.openGlobalKeybindings]}" InputGestureText="Ctrl+K Ctrl+S" />
          </MenuItem>
          <MenuItem Header="编辑" Style="{StaticResource TitleBarMenuItemStyle}">
            <MenuItem Header="复制所选内容" Command="{Binding Commands[nornia.action.copyFocused]}" InputGestureText="Ctrl+C" />
          </MenuItem>
          <MenuItem Header="选择" Style="{StaticResource TitleBarMenuItemStyle}">
            <MenuItem Header="全选当前列表" Command="{Binding Commands[nornia.action.selectAllFocused]}" InputGestureText="Ctrl+A" />
          </MenuItem>
          <MenuItem Header="查看" Style="{StaticResource TitleBarMenuItemStyle}">
            <MenuItem Header="命令面板…" Command="{Binding Commands[workbench.action.showCommands]}" InputGestureText="Ctrl+Shift+P" />
            <Separator />
            <MenuItem Header="切换侧栏" Command="{Binding Commands[workbench.action.toggleSidebarVisibility]}" InputGestureText="Ctrl+B" />
            <MenuItem Header="切换底栏" Command="{Binding Commands[workbench.action.togglePanel]}" InputGestureText="Ctrl+J" />
            <Separator />
            <MenuItem Header="向右拆分编辑器" Command="{Binding Commands[workbench.action.splitEditorRight]}" InputGestureText="Ctrl+\" />
            <MenuItem Header="向下拆分编辑器" Command="{Binding Commands[workbench.action.splitEditorDown]}" InputGestureText="Ctrl+Shift+\" />
            <MenuItem Header="聚焦下一个编辑器组" Command="{Binding Commands[workbench.action.focusNextEditorGroup]}" />
            <MenuItem Header="聚焦上一个编辑器组" Command="{Binding Commands[workbench.action.focusPreviousEditorGroup]}" />
            <Separator />
            <MenuItem Header="终端：新建终端" Command="{Binding Commands[workbench.action.terminal.toggleTerminal]}" InputGestureText="Ctrl+`" />
            <MenuItem Header="显示输出面板" Command="{Binding Commands[nornia.panel.output]}" />
            <MenuItem Header="显示问题面板" Command="{Binding Commands[nornia.panel.problems]}" />
            <MenuItem Header="显示终端面板" Command="{Binding Commands[nornia.panel.terminal]}" />
            <Separator />
            <MenuItem Header="主题">
              <MenuItem Header="深色" Command="{Binding Commands[nornia.theme.dark]}" />
              <MenuItem Header="浅色" Command="{Binding Commands[nornia.theme.light]}" />
              <MenuItem Header="高对比度" Command="{Binding Commands[nornia.theme.highContrast]}" />
            </MenuItem>
          </MenuItem>
          <MenuItem Header="转到" Style="{StaticResource TitleBarMenuItemStyle}">
            <MenuItem Header="后退" Command="{Binding GoBackCommand}" />
            <MenuItem Header="前进" Command="{Binding GoForwardCommand}" />
            <MenuItem Header="转到文件…" Command="{Binding Commands[workbench.action.quickOpen]}" InputGestureText="Ctrl+P" />
            <Separator />
            <MenuItem Header="转到下一个更改" Command="{Binding Commands[workbench.action.compareEditor.nextChange]}" InputGestureText="Alt+F5" />
            <MenuItem Header="转到上一个更改" Command="{Binding Commands[workbench.action.compareEditor.previousChange]}" InputGestureText="Shift+Alt+F5" />
          </MenuItem>
          <MenuItem Header="运行" Style="{StaticResource TitleBarMenuItemStyle}">
            <MenuItem Header="刷新活动视图" Command="{Binding Commands[workbench.action.refreshActiveView]}" InputGestureText="F5" />
          </MenuItem>
          <MenuItem Header="终端" Style="{StaticResource TitleBarMenuItemStyle}">
            <MenuItem Header="新建终端" Command="{Binding Commands[workbench.action.terminal.new]}" InputGestureText="Ctrl+Shift+`" />
            <MenuItem Header="切换终端" Command="{Binding Commands[workbench.action.terminal.toggleTerminal]}" InputGestureText="Ctrl+`" />
            <MenuItem Header="聚焦终端" Command="{Binding Commands[workbench.action.terminal.focus]}" InputGestureText="Ctrl+/" />
            <MenuItem Header="清除终端" Command="{Binding Commands[workbench.action.terminal.clear]}" InputGestureText="Ctrl+Shift+K" />
            <MenuItem Header="关闭当前终端" Command="{Binding Commands[workbench.action.terminal.kill]}" />
          </MenuItem>
          <MenuItem Header="帮助" Style="{StaticResource TitleBarMenuItemStyle}">
            <MenuItem Header="键盘快捷键参考" Command="{Binding Commands[workbench.action.openGlobalKeybindings]}" InputGestureText="Ctrl+K Ctrl+S" />
            <Separator />
            <MenuItem Header="关于 Nornia" Command="{Binding Commands[nornia.about]}" />
          </MenuItem>
        </Menu>

        <!-- 中部: 返回/前进按钮(内存导航历史)+ 工作区命令中心(当前工作区名称, 无项目时 Nornia) -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource TitleBarIconButton}" Command="{Binding GoBackCommand}"
                  ToolTip="{loc:StringLoc Key=NavBack}" AutomationProperties.Name="{loc:StringLoc Key=NavBack}"
                  AutomationProperties.AutomationId="NavigateBack">
            <TextBlock Text="{StaticResource CodiconArrowLeft}" FontFamily="{StaticResource IconFontFamily}"
                       FontSize="{DynamicResource IconInline}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Style="{StaticResource TitleBarIconButton}" Command="{Binding GoForwardCommand}"
                  ToolTip="{loc:StringLoc Key=NavForward}" AutomationProperties.Name="{loc:StringLoc Key=NavForward}"
                  AutomationProperties.AutomationId="NavigateForward">
            <TextBlock Text="{StaticResource CodiconArrowRight}" FontFamily="{StaticResource IconFontFamily}"
                       FontSize="{DynamicResource IconInline}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button x:Name="CommandCenterButton" Style="{StaticResource TitleBarCommandCenterButton}"
                  Command="{Binding Commands[workbench.action.showCommands]}"
                  ToolTip="命令面板" AutomationProperties.Name="命令面板"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{StaticResource CodiconFolder}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}"
                         Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="{Binding WorkspaceTitle}" FontSize="{DynamicResource TypeBody}"
                         Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- 右侧: 左边栏切换 / 底栏切换 位于窗口控制按钮之前(VS Code 布局切换按钮)。
             侧栏切换使用 VS Code layout-sidebar-left 风格的轮廓图形,避免把文件夹字形误当作
             布局与窗口控制统一使用 Codicon 字形。 -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="ToggleSidebarButton" Style="{StaticResource TitleBarSidebarToggleButton}"
                  Command="{Binding Commands[workbench.action.toggleSidebarVisibility]}"
                  ToolTip="{loc:StringLoc Key=ToggleSidebar}" AutomationProperties.Name="{loc:StringLoc Key=ToggleSidebar}"
                  AutomationProperties.AutomationId="ToggleSidebar">
            <TextBlock Text="{StaticResource CodiconLayoutSidebarLeft}" FontFamily="{StaticResource IconFontFamily}"
                       FontSize="{DynamicResource IconInline}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button x:Name="TogglePanelButton" Style="{StaticResource TitleBarPanelToggleButton}"
                  Command="{Binding Commands[workbench.action.togglePanel]}"
                  ToolTip="{loc:StringLoc Key=TogglePanel}" AutomationProperties.Name="{loc:StringLoc Key=TogglePanel}"
                  AutomationProperties.AutomationId="TogglePanel">
            <TextBlock Text="{StaticResource CodiconLayoutPanel}" FontFamily="{StaticResource IconFontFamily}"
                       FontSize="{DynamicResource IconInline}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButtonStyle}"
                  Click="MinimizeButton_Click"
                  AutomationProperties.AutomationId="MinimizeWindow" AutomationProperties.Name="最小化">
            <TextBlock Text="{StaticResource CodiconChromeMinimize}" FontFamily="{StaticResource IconFontFamily}"
                       FontSize="{DynamicResource IconClose}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButtonStyle}"
                  Click="MaximizeButton_Click"
                  AutomationProperties.AutomationId="MaximizeWindow" AutomationProperties.Name="最大化">
            <TextBlock x:Name="MaximizeGlyph" Text="{StaticResource CodiconChromeMaximize}" FontFamily="{StaticResource IconFontFamily}"
                       FontSize="{DynamicResource IconClose}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButton}"
                  Click="CloseButton_Click"
                  AutomationProperties.AutomationId="CloseWindow" AutomationProperties.Name="关闭">
            <TextBlock Text="{StaticResource CodiconChromeClose}" FontFamily="{StaticResource IconFontFamily}"
                       FontSize="{DynamicResource IconClose}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Workbench (VS Code shell: activity bar | secondary left sidebar | editor area) -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <!-- Activity bar width follows the glyph scale (48px items inside). -->
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="0" MaxWidth="960" />
        <ColumnDefinition x:Name="SidebarSplitterColumn" Width="5" />
        <ColumnDefinition Width="*" MinWidth="{DynamicResource MinEditorWidth}" />
      </Grid.ColumnDefinitions>

      <!-- Activity bar: the settings page is one of the six activity items, so there is no
             separate bottom-pinned gear (it would duplicate the button). -->
      <Border Grid.Column="0" Background="{DynamicResource ActivityBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   PreviewMouseLeftButtonDown="ActivityBar_PreviewMouseLeftButtonDown"
                   MouseLeftButtonUp="ActivityBar_MouseLeftButtonUp"
                   ItemContainerStyle="{StaticResource ActivityItemStyle}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFontFamily}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Title}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="{DynamicResource IconActivity}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding DataContext.IsCompactActivityBar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="FontSize" Value="{DynamicResource IconActivityCompact}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                          MinWidth="16" Height="16" CornerRadius="8" Padding="4,0"
                          Background="{DynamicResource ActivityBarBadgeBackgroundBrush}"
                          Visibility="{Binding Badge, Converter={StaticResource StringEmptyToCollapsedConverter}}">
                    <TextBlock Text="{Binding Badge}" Foreground="{DynamicResource ActivityBarBadgeForegroundBrush}"
                               FontSize="{DynamicResource IconBadge}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Secondary left sidebar (per-page views; Ctrl+B hides it, and the column collapses when the page has none).
           壳先行(内容延后):六个页面侧栏(最重的 GitView 近千行 XAML)不在窗口首建路径实例化,
           由 MainWindow.xaml.cs 在首帧渲染后分阶段物化并插入本宿主(当前页随内容首阶段,其余空闲期补建);
           物化后视图常驻,切换页面只切换 Visibility——滚动位置与展开状态得以保留,反复打开不卡顿。 -->
      <Grid x:Name="SidebarHost" Grid.Column="1" Visibility="{Binding IsSidebarColumnVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <!-- 侧栏视图由代码在首帧后分阶段物化并 Add 到本宿主(见 MainWindow.xaml.cs 的
             MaterializeSidebarFor):可见性以窗口 DataContext(MainViewModel)为准,子视图的
             DataContext 是各页 VM,直接绑 CurrentPage.Sidebar 会在页 VM 上解析不到 CurrentPage,
             绑定失败退回 Visible,五个侧栏全部叠在一起,最后一个(设置)盖在最上层。
             DataContext 与 Visibility 绑定均在物化时以代码等效复刻原 XAML 声明。 -->
      </Grid>

      <GridSplitter x:Name="SidebarSplitter" Grid.Column="2" Width="{DynamicResource SizeSashHitArea}"
                    Style="{StaticResource VerticalSashStyle}" ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext" DragCompleted="SidebarSplitter_DragCompleted"
                    Visibility="{Binding IsSidebarColumnVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <!-- Editor and panel -->
      <Grid x:Name="EditorPanelHost" Grid.Column="3" Background="{DynamicResource EditorBrush}" SizeChanged="EditorPanelHost_SizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="EditorHostRow" Height="*" />
          <RowDefinition x:Name="PanelSplitterRow" Height="0" />
          <RowDefinition x:Name="PanelRow" Height="0" MinHeight="0" />
        </Grid.RowDefinitions>

        <!-- 可拆分的多编辑器组工作台:页面标签条 + 递归组网格(EditorGroupsView)。
             壳先行:工作台视图在首帧后由代码物化并插入本宿主(阶段 1,
             见 MainWindow.xaml.cs MaterializeEditorWorkbench);
             视图页无文档选中时,欢迎层叠加在其上(复用窗口资源中的模板)。 -->
        <Grid x:Name="EditorWorkbenchHost" Grid.Row="0" />
        <!-- View-page welcomes (Explorer / Source Control) replace the editor group's own empty
             state. Give the overlay an opaque editor surface so the two empty-state messages do
             not show through each other when no document tab is open. -->
        <Border Grid.Row="0" Background="{DynamicResource EditorBrush}" Panel.ZIndex="1"
                Visibility="{Binding ShowViewPageWelcome, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ContentControl Content="{Binding CurrentPage}"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Border>

        <GridSplitter x:Name="PanelSplitter" Grid.Row="1" Height="{DynamicResource SizeSashHitArea}"
                      Style="{StaticResource HorizontalSashStyle}" ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext" DragCompleted="PanelSplitter_DragCompleted" />

        <!-- Bottom panel (VS Code: tabs with accent top border, dark surface) -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding IsPanelExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid>
            <!-- Fixed three-slot header prevents filters and contextual actions from competing for
                 DockPanel's remaining width when the panel is narrow. -->
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="{DynamicResource SizeTabBar}" Margin="12,0,8,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="{loc:StringLoc Key=Panel_Output}" Command="{Binding Commands[nornia.panel.output]}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PanelTabButton}">
                      <Setter Property="MinWidth" Value="78" />
                      <Setter Property="Padding" Value="12,0,12,1" />
                      <Setter Property="Margin" Value="0" />
                      <Style.Triggers><DataTrigger Binding="{Binding IsOutputSelected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PanelTitleActiveForegroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PanelTitleActiveBorderBrush}" /></DataTrigger></Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Content="{Binding ProblemsTabTitle}" Command="{Binding Commands[nornia.panel.problems]}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PanelTabButton}">
                      <Setter Property="MinWidth" Value="78" />
                      <Setter Property="Padding" Value="12,0,12,1" />
                      <Setter Property="Margin" Value="0" />
                      <Style.Triggers><DataTrigger Binding="{Binding IsProblemsSelected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PanelTitleActiveForegroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PanelTitleActiveBorderBrush}" /></DataTrigger></Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Content="{loc:StringLoc Key=Panel_Terminal}" Command="{Binding Commands[nornia.panel.terminal]}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PanelTabButton}">
                      <Setter Property="MinWidth" Value="78" />
                      <Setter Property="Padding" Value="12,0,12,1" />
                      <Setter Property="Margin" Value="0" />
                      <Style.Triggers><DataTrigger Binding="{Binding IsTerminalSelected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PanelTitleActiveForegroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PanelTitleActiveBorderBrush}" /></DataTrigger></Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
              <!-- 日志搜索/级别过滤仅服务于输出与问题面板;终端选中时隐藏。 -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                          Visibility="{Binding IsTerminalSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBox Width="180" Text="{Binding PanelSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:StringLoc Key=Search_LogPlaceholder}" />
                <ComboBox Width="104" Margin="8,0,0,0"
                          ItemsSource="{Binding PanelLevelOptions}"
                          SelectedItem="{Binding PanelLevelFilter}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource LogPanelLevelFilterToLabelConverter}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <!-- A single right-aligned action slot keeps terminal controls, clear and collapse
                   actions mutually non-overlapping in every panel mode. -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsTerminalSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconNewSession}" FontSize="{DynamicResource IconInline}"
                          Command="{Binding Commands[workbench.action.terminal.new]}" AutomationProperties.Name="新建终端" ToolTip="新建终端"
                          FontFamily="{StaticResource IconFontFamily}" />
                  <ComboBox Width="150" Margin="4,0" VerticalAlignment="Center"
                            ItemsSource="{Binding Terminal.Profiles}" SelectedItem="{Binding Terminal.SelectedProfile}"
                            DisplayMemberPath="Name" ToolTip="默认 Shell 配置文件(已有会话不受切换影响)" />
                  <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconClearAll}" FontSize="{DynamicResource IconInline}"
                          Command="{Binding Commands[workbench.action.terminal.clear]}"
                          AutomationProperties.Name="清屏" ToolTip="清屏" FontFamily="{StaticResource IconFontFamily}" />
                  <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconClose}" FontSize="{DynamicResource IconInline}"
                          Command="{Binding Commands[workbench.action.terminal.kill]}"
                          AutomationProperties.Name="关闭当前终端" ToolTip="关闭当前终端" FontFamily="{StaticResource IconFontFamily}" />
                </StackPanel>
                <!-- 清除输出仅服务于输出面板;终端的清屏在终端工具区。 -->
                <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconClearAll}" Command="{Binding Commands[nornia.output.clear]}" AutomationProperties.Name="{loc:StringLoc Key=ClearOutput}" FontFamily="{StaticResource IconFontFamily}"
                        Visibility="{Binding IsTerminalSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <Button Style="{StaticResource IconButton}" Command="{Binding Commands[workbench.action.toggleMaximizedPanel]}"
                        AutomationProperties.Name="最大化/恢复面板" FontFamily="{StaticResource IconFontFamily}" ToolTip="最大化/恢复面板">
                  <TextBlock FontFamily="{StaticResource IconFontFamily}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{StaticResource CodiconChromeMaximize}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPanelMaximized}" Value="True">
                            <Setter Property="Text" Value="{StaticResource CodiconChromeRestore}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconChevronDown}" Command="{Binding Commands[workbench.action.togglePanel]}" AutomationProperties.Name="{loc:StringLoc Key=CollapsePanel}" FontFamily="{StaticResource IconFontFamily}" />
              </StackPanel>
            </Grid>
            <ListBox x:Name="OutputPanelList" Grid.Row="1" ItemsSource="{Binding OutputView}" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsOutputSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                     FontFamily="{StaticResource MonoFontFamily}" FontSize="{DynamicResource TypeBody}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionMode="Extended" KeyboardNavigation.TabNavigation="None"
                     b:MultiSelectorBinding.SelectedItems="{Binding SelectedOutputEntries}"
                     b:ListSelectionBehavior.SelectOnRightClick="True">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBackground" Background="Transparent">
                          <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource HoverBrush}" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource SelectionActiveBrush}" />
                          </Trigger>
                          <Trigger Property="IsMouseCaptured" Value="True">
                            <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource PressedBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding DisplayText}" Foreground="{DynamicResource TextBrush}" Margin="12,3" TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="{loc:StringLoc Key=Copy}" Command="{Binding CopySelectedOutputCommand}" InputGestureText="Ctrl+C" />
                  <MenuItem Header="{loc:StringLoc Key=CopyMessage}" Command="{Binding CopyOutputMessagesCommand}" />
                  <Separator />
                  <MenuItem Header="{loc:StringLoc Key=CopyAll}" Command="{Binding CopyAllOutputCommand}" />
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>
            <ListBox x:Name="ProblemsPanelList" Grid.Row="1" ItemsSource="{Binding ProblemView}" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsProblemsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                     FontFamily="{StaticResource MonoFontFamily}" FontSize="{DynamicResource TypeBody}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionMode="Extended" KeyboardNavigation.TabNavigation="None"
                     b:MultiSelectorBinding.SelectedItems="{Binding SelectedProblemEntries}"
                     b:ListSelectionBehavior.SelectOnRightClick="True">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBackground" Background="Transparent">
                          <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource HoverBrush}" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource SelectionActiveBrush}" />
                          </Trigger>
                          <Trigger Property="IsMouseCaptured" Value="True">
                            <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource PressedBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Level, Converter={StaticResource LogLevelToGlyphConverter}}"
                               FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}"
                               Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}"
                               VerticalAlignment="Center" Margin="12,0,8,0" />
                    <TextBlock Text="{Binding DisplayText}"
                               Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,3,12,3" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="{loc:StringLoc Key=Copy}" Command="{Binding CopySelectedProblemsCommand}" InputGestureText="Ctrl+C" />
                  <MenuItem Header="{loc:StringLoc Key=CopyMessage}" Command="{Binding CopyProblemMessagesCommand}" />
                  <Separator />
                  <MenuItem Header="{loc:StringLoc Key=CopyAll}" Command="{Binding CopyAllProblemsCommand}" />
                  <Separator />
                  <MenuItem Header="{loc:StringLoc Key=ClearMessages}" Command="{Binding ClearProblemsCommand}" />
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>
            <!-- 壳先行:终端视图(含终端表面,重子树)在首帧后的空闲阶段由代码物化并设入本宿主
                 (见 MainWindow.xaml.cs MaterializeTerminal);PanelTerminalView 字段随之在代码中声明。 -->
            <ContentControl x:Name="PanelTerminalHost" Grid.Row="1"
                            Visibility="{Binding IsTerminalSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Status bar (VS Code Dark Modern: dark surface, clickable left/right item groups) — VS Code default 22px -->
    <Border Grid.Row="2" Background="{DynamicResource StatusBarBackgroundBrush}"
            BorderBrush="{DynamicResource StatusBarBorderBrush}" BorderThickness="0,1,0,0"
            MinHeight="{DynamicResource SizeStatusBar}">
      <Grid>
        <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal">
          <!-- Cancel running operation (CanExecute rides IsBusy + CanCancel, so it auto-disables when done) -->
          <Button Style="{StaticResource StatusBarItem}" Command="{Binding OperationPage.CancelOperationCommand}"
                  AutomationProperties.Name="{loc:StringLoc Key=Op_Cancel}"
                  Visibility="{Binding OperationPage.HasOperation, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{StaticResource CodiconClose}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}" />
          </Button>
          <!-- Git branch + ↑/↓ sync badges (VS Code: click opens source control) -->
          <Button Style="{StaticResource StatusBarItem}" Command="{Binding OpenGitCommand}" ToolTip="打开源代码管理"
                  Visibility="{Binding Git.IsRepository, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{StaticResource CodiconSourceControl}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="{Binding Git.CurrentBranch}" FontSize="{DynamicResource TypeBody}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
              <TextBlock FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource SuccessBrush}"
                         VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="待推送的本地提交"
                         Visibility="{Binding Git.AheadCount, Converter={StaticResource NonZeroCountToVisibilityConverter}}"><Run Text="{StaticResource CodiconArrowUp}" FontFamily="{StaticResource IconFontFamily}" /><Run Text="{Binding Git.AheadCount, StringFormat={}{0}}" /></TextBlock>
              <TextBlock FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource WarningBrush}"
                         VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="待从远端拉取的提交"
                         Visibility="{Binding Git.BehindCount, Converter={StaticResource NonZeroCountToVisibilityConverter}}"><Run Text="{StaticResource CodiconArrowDown}" FontFamily="{StaticResource IconFontFamily}" /><Run Text="{Binding Git.BehindCount, StringFormat={}{0}}" /></TextBlock>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource StatusBarItem}" Command="{Binding Workbench.ShowOperationLogCommand}" ToolTip="显示操作日志">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding EnvironmentHealthGlyph}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="{Binding EnvironmentHealthText}" FontSize="{DynamicResource TypeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding PendingChordText}" Padding="8,0" VerticalAlignment="Center"
                     Visibility="{Binding PendingChordText, Converter={StaticResource StringEmptyToCollapsedConverter}}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <!-- 当前文档状态(原视图内独立底栏的内容):位置 · 只读 · 语言(可点切换)/Diff 模式,
               文件文档再跟编码/行尾/行数/大小/提示/自动换行,diff 再跟 diff 行数。
               仅在选中编辑器文档/diff 标签时显示(页面标签/空选择整段收拢);
               分屏时显示当前选中标签的状态(VS Code 同一语义)。 -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding Workbench.SelectedEditorTab.EditorTab, Converter={StaticResource DocumentTabVisibilityConverter}}">
            <TextBlock Text="{Binding Workbench.SelectedEditorTab.EditorTab.CaretPositionText}" FontSize="{DynamicResource TypeBody}"
                       Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" MinWidth="96" />
            <TextBlock Text="只读" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" />
            <TextBlock Text="·" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" Margin="8,0" />
          </StackPanel>
          <!-- 语言(文件文档,点击打开语言选择器;VS Code"更改语言模式") -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding Workbench.SelectedEditorTab.EditorTab, Converter={StaticResource DocumentTabVisibilityConverter}, ConverterParameter=file}">
            <TextBlock Text="·" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" Margin="8,0" />
            <Button Style="{StaticResource LinkButton}" Content="{Binding Workbench.SelectedEditorTab.EditorTab.LanguageName}"
                    FontSize="{DynamicResource TypeBody}" Padding="0,0"
                    Command="{Binding Workbench.Editor.OpenLanguagePickerCommand}" ToolTip="更改语言模式" />
          </StackPanel>
          <!-- Diff 模式 -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding Workbench.SelectedEditorTab.EditorTab, Converter={StaticResource DocumentTabVisibilityConverter}, ConverterParameter=diff}">
            <TextBlock Text="·" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" Margin="8,0" />
            <TextBlock Text="{Binding Workbench.SelectedEditorTab.EditorTab.DiffModeLabel}" FontSize="{DynamicResource TypeBody}"
                       Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <!-- 文件文档明细:编码 · 行尾 · 行数 · 大小 · (Markdown/外部变更提示) · 自动换行 -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding Workbench.SelectedEditorTab.EditorTab, Converter={StaticResource DocumentTabVisibilityConverter}, ConverterParameter=file}">
            <TextBlock Text="·" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" Margin="8,0" />
            <TextBlock Text="{Binding Workbench.SelectedEditorTab.EditorTab.EncodingName}" FontSize="{DynamicResource TypeBody}"
                       Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" />
            <TextBlock Text="·" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" Margin="8,0" />
            <TextBlock Text="{Binding Workbench.SelectedEditorTab.EditorTab.NewlineTypeText}" FontSize="{DynamicResource TypeBody}"
                       Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" />
            <TextBlock Text="·" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" Margin="8,0" />
            <TextBlock FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center">
              <Run Text="{Binding Workbench.SelectedEditorTab.EditorTab.LineCount}" /><Run Text=" 行" />
            </TextBlock>
            <TextBlock Text="·" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" Margin="8,0" />
            <TextBlock Text="{Binding Workbench.SelectedEditorTab.EditorTab.FileSizeText}" FontSize="{DynamicResource TypeBody}"
                       Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Workbench.SelectedEditorTab.EditorTab.MarkdownRenderNotice}" FontSize="{DynamicResource TypeBody}"
                       Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            <!-- 外部文件变更提示(独立于 Notice):旧源码仍可读,只在状态栏提示,不遮挡内容。 -->
            <TextBlock Text="{Binding Workbench.SelectedEditorTab.EditorTab.FileChangeNotice}" FontSize="{DynamicResource TypeBody}"
                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Workbench.SelectedEditorTab.EditorTab.FileChangeNotice}"
                       Visibility="{Binding Workbench.SelectedEditorTab.EditorTab.FileChangeNotice, Converter={StaticResource StringEmptyToCollapsedConverter}}" />
            <TextBlock Text="·" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" Margin="8,0" />
            <Button Style="{StaticResource LinkButton}" Content="自动换行" FontSize="{DynamicResource TypeBody}" Padding="0,0"
                    Command="{Binding Workbench.SelectedEditorTab.EditorTab.ToggleWordWrapCommand}" ToolTip="切换自动换行" />
          </StackPanel>
          <!-- Diff 明细:diff 行数 -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding Workbench.SelectedEditorTab.EditorTab, Converter={StaticResource DocumentTabVisibilityConverter}, ConverterParameter=diff}">
            <TextBlock Text="·" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center" Margin="8,0" />
            <TextBlock FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource StatusBarForegroundBrush}" VerticalAlignment="Center">
              <!-- Run.Text 默认 TwoWay,而 DiffLines.Count 只读,必须显式 OneWay -->
              <Run Text="{Binding Workbench.SelectedEditorTab.EditorTab.DiffLines.Count, Mode=OneWay}" /><Run Text=" diff 行" />
            </TextBlock>
          </StackPanel>
          <!-- Problem counters (VS Code errors/warnings, click opens the problems panel) -->
          <Button Style="{StaticResource StatusBarItem}" Command="{Binding ShowProblemsCommand}" ToolTip="错误"
                  Visibility="{Binding ProblemErrorCount, Converter={StaticResource NonZeroCountToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{StaticResource CodiconError}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}" Foreground="{DynamicResource ErrorTextBrush}"
                         VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBlock Text="{Binding ProblemErrorCount}" FontSize="{DynamicResource TypeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource StatusBarItem}" Command="{Binding ShowProblemsCommand}" ToolTip="警告"
                  Visibility="{Binding ProblemWarningCount, Converter={StaticResource NonZeroCountToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{StaticResource CodiconWarning}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}" Foreground="{DynamicResource WarningBrush}"
                         VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBlock Text="{Binding ProblemWarningCount}" FontSize="{DynamicResource TypeBody}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource StatusBarItem}" Command="{Binding Workbench.ShowOperationLogCommand}"
                  Visibility="{Binding OperationPage.StatusMessage, Converter={StaticResource StringEmptyToCollapsedConverter}}">
            <Button.ToolTip>
              <StackPanel>
                <TextBlock Text="{Binding OperationPage.CurrentOperation.LogReferenceDisplay}"
                           Visibility="{Binding OperationPage.CurrentOperation.LogReferenceDisplay, Converter={StaticResource StringEmptyToCollapsedConverter}}" />
                <TextBlock Text="{Binding OperationPage.CurrentOperation.RecommendedNextStep, StringFormat=下一步：{0}}"
                           Visibility="{Binding OperationPage.CurrentOperation.RecommendedNextStep, Converter={StaticResource StringEmptyToCollapsedConverter}}" />
              </StackPanel>
            </Button.ToolTip>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding OperationPage.StatusKind, Converter={StaticResource StatusKindToGlyphConverter}}"
                         FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}"
                         Foreground="{Binding OperationPage.StatusKind, Converter={StaticResource StatusKindToBrushConverter}}"
                         VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBlock Text="{Binding OperationPage.StatusMessage}" FontSize="{DynamicResource TypeBody}"
                         Foreground="{Binding OperationPage.StatusKind, Converter={StaticResource StatusKindToBrushConverter}}"
                         VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource StatusBarItem}" Command="{Binding Commands[workbench.action.togglePanel]}" ToolTip="{loc:StringLoc Key=TogglePanel}">
            <TextBlock Text="{StaticResource CodiconChevronDown}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}" />
          </Button>
          <Button Style="{StaticResource StatusBarItem}" Command="{Binding Commands[workbench.action.openSettings]}" ToolTip="{loc:StringLoc Key=Settings}">
            <TextBlock Text="{StaticResource CodiconSettings}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}" />
          </Button>
        </StackPanel>
        </DockPanel>
        <!-- Indeterminate progress hairline overlaying the status bar top edge; does not consume bar height -->
        <Border Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="{DynamicResource StatusBarBackgroundBrush}"
                IsHitTestVisible="False"
                Visibility="{Binding OperationPage.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ProgressBar Height="2" IsIndeterminate="True" BorderThickness="0" Background="Transparent"
                       Foreground="{DynamicResource StatusBarForegroundBrush}" />
        </Border>
      </Grid>
    </Border>

    <!-- QuickInput (VS Code command palette / quick open):
         全窗口遮罩压暗整个壳层(标题栏/侧栏/编辑器/状态栏,VS Code 行为),调色板浮于顶部居中。
         遮罩与承载面板必须是根 Grid 的最后子元素:遮罩盖过状态栏,承载面板再盖过遮罩,
         否则状态栏(按绘制顺序在其后)会盖在遮罩之上、标题栏/状态栏不会被压暗;
         点击遮罩空白处关闭(QuickInputBackdrop_MouseLeftButtonDown)。 -->
    <Border Grid.RowSpan="3" Background="{DynamicResource QuickInputBackdropBrush}"
            Visibility="{Binding QuickInput.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
            MouseLeftButtonDown="QuickInputBackdrop_MouseLeftButtonDown" />
    <Border Grid.RowSpan="3" x:Name="QuickInputOverlay"
            Visibility="{Binding QuickInput.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
            PreviewKeyDown="QuickInputOverlay_PreviewKeyDown">
      <!-- 72 = SizeTitleBar(35) + 36 + 1(标题栏底边):命令面板定位在标题栏下方 36px -->
      <Border Width="{DynamicResource SizeCommandPalette}" MaxHeight="400" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0"
              Background="{DynamicResource QuickInputBackgroundBrush}" BorderBrush="{DynamicResource StrongBorderBrush}"
              BorderThickness="1" CornerRadius="{StaticResource RadiusMd}">
        <StackPanel>
          <Grid>
            <TextBlock Text="{StaticResource CodiconSearch}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}" Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
            <TextBox x:Name="QuickInputBox" BorderThickness="0" Background="Transparent" Padding="32,8"
                     FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource TextBrush}"
                     Text="{Binding QuickInput.FilterText, UpdateSourceTrigger=PropertyChanged}"
                     IsVisibleChanged="QuickInputBox_IsVisibleChanged" />
          </Grid>
          <Border Background="{DynamicResource BorderBrush}" Height="1" />
          <ListBox MaxHeight="320" ItemsSource="{Binding QuickInput.View}" SelectedItem="{Binding QuickInput.SelectedItem}"
                   Background="Transparent" BorderThickness="0" Padding="0,2"
                   KeyboardNavigation.TabNavigation="None"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}" /></Trigger>
                        <Trigger Property="IsMouseCaptured" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PressedBrush}" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}"
                             Foreground="{DynamicResource NavGlyphBrush}" VerticalAlignment="Center" Margin="4,0,12,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="{DynamicResource TypeBody}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource MutedTextBrush}"
                             VerticalAlignment="Center" Margin="12,0,4,0" TextTrimming="CharacterEllipsis" MaxWidth="200"
                             Visibility="{Binding Detail, Converter={StaticResource NullToCollapsedConverter}}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding QuickInput.Title}" FontSize="{DynamicResource TypeBody}" Foreground="{DynamicResource MutedTextBrush}"
                     Margin="12,4,12,8" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
