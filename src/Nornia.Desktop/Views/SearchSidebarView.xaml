<UserControl x:Class="Nornia.Desktop.Views.SearchSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nornia.Desktop.ViewModels"
             xmlns:views="clr-namespace:Nornia.Desktop.Views"
             xmlns:controls="clr-namespace:Nornia.Desktop.Views.Controls"
             xmlns:loc="clr-namespace:Nornia.Desktop.Localization">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type local:SearchTreeNode}">
      <Grid MinHeight="{DynamicResource SizeRowSm}">
        <controls:SidebarTreeGuideLayer GuideLefts="{Binding AncestorGuideLefts}" ShowGuides="True" />
        <controls:SidebarRowChrome Indent="{Binding Indent}" ShowExpander="{Binding HasChildren}"
                                    ShowGlyph="{Binding ShowsGlyph}"
                                    GlyphInExpanderCell="{Binding GlyphInExpanderCell}"
                                    IsExpanded="{Binding IsExpanded}"
                                    MinHeight="{DynamicResource SizeRowSm}"
                                    ToggleCommand="{Binding DataContext.ToggleNodeCommand, RelativeSource={RelativeSource AncestorType=views:SearchSidebarView}}"
                                    ToggleCommandParameter="{Binding}">
        <controls:SidebarRowChrome.GlyphContent>
          <Grid Width="20" Height="{DynamicResource SizeRowSm}">
            <controls:SidebarFileTypeBadge Path="{Binding FullPath}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsFile, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFontFamily}"
                       FontSize="{DynamicResource IconInline}" Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMatch}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </controls:SidebarRowChrome.GlyphContent>
        <controls:SidebarRowChrome.MainContent>
          <Grid MinWidth="0" MinHeight="{DynamicResource SizeRowSm}" Margin="0,0,8,0" ToolTip="{Binding ToolTipText}">
            <Grid MinWidth="0" Margin="4,0,0,0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
              <Border Margin="6,0,0,0" Style="{StaticResource SidebarCountBadgeStyle}"
                      Grid.Column="1"
                      Visibility="{Binding ShowsMatchBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding MatchCount}" Style="{StaticResource SidebarCountBadgeTextStyle}" />
              </Border>
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers><DataTrigger Binding="{Binding IsMatch}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
              </Grid.Style>
            </Grid>
            <Grid MinWidth="0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding IsMatch}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </Grid.Style>
              <TextBlock Grid.Column="0" Text="{Binding LocationLabel}" TextAlignment="Left"
                         FontFamily="{StaticResource MonoFontFamily}" FontSize="{DynamicResource TypeBadge}"
                         Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"
                         Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
              <!-- S10: one TextBlock with at most three Runs (before/match/after) instead of an
                   ItemsControl of per-segment TextBlocks + DataTriggers; the parts are the same
                   PreviewSegments data projected by the VM. Same separators/colors as before:
                   context text in SubtleTextBrush, the hit in CodeSearchMatchBrush/SemiBold. -->
              <TextBlock Grid.Column="1"
                         FontSize="{DynamicResource TypeBody}" TextWrapping="NoWrap"
                         MinWidth="0" MaxHeight="{DynamicResource SizeRowSm}" ClipToBounds="True"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" IsHitTestVisible="False">
                <!-- Run 没有 Visibility(非 FrameworkElement):无内容时绑定的文本为空串,
                     渲染零宽度,与旧模板段的隐藏语义一致。 -->
                <Run Text="{Binding PreviewBeforeText, Mode=OneWay}" Foreground="{DynamicResource SubtleTextBrush}" />
                <Run Text="{Binding PreviewMatchText, Mode=OneWay}" FontWeight="SemiBold"
                      Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CodeSearchMatchBrush}" />
                <Run Text="{Binding PreviewAfterText, Mode=OneWay}" Foreground="{DynamicResource SubtleTextBrush}" />
              </TextBlock>
            </Grid>
          </Grid>
        </controls:SidebarRowChrome.MainContent>
        </controls:SidebarRowChrome>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <controls:SidebarShell Title="{loc:StringLoc Key=Search_Title}">
    <controls:SidebarShell.HeaderActions>
      <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconUnfold}" FontFamily="{StaticResource IconFontFamily}"
                  ToolTip="{loc:StringLoc Key=Search_ExpandAll}" Command="{Binding ExpandAllCommand}" Margin="0" />
          <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconCollapseAll}" FontFamily="{StaticResource IconFontFamily}"
                  ToolTip="{loc:StringLoc Key=Search_CollapseAll}" Command="{Binding CollapseAllCommand}" Margin="0" />
          <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconListTree}" FontFamily="{StaticResource IconFontFamily}"
                  ToolTip="{loc:StringLoc Key=Search_TreeView}" Command="{Binding ShowTreeViewCommand}"
                  IsEnabled="{Binding IsListView}" Margin="0" />
          <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconListFlat}" FontFamily="{StaticResource IconFontFamily}"
                  ToolTip="{loc:StringLoc Key=Search_ListView}" Command="{Binding ShowListViewCommand}"
                  IsEnabled="{Binding IsTreeView}" Margin="0" />
          <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconClearAll}" FontFamily="{StaticResource IconFontFamily}"
                  ToolTip="{loc:StringLoc Key=Search_Clear}" Command="{Binding ClearSearchCommand}" Margin="0" />
      </StackPanel>
    </controls:SidebarShell.HeaderActions>
    <controls:SidebarShell.BodyContent>
      <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="8,6,8,0">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{loc:StringLoc Key=Search_Placeholder}" AutomationProperties.Name="{loc:StringLoc Key=Search_Placeholder}" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <CheckBox Content="Aa" IsChecked="{Binding SearchCaseSensitive}" ToolTip="{loc:StringLoc Key=Search_CaseSensitive}" Margin="0,0,8,0" />
          <CheckBox Content="ab" IsChecked="{Binding SearchWholeWord}" ToolTip="{loc:StringLoc Key=Search_WholeWord}" Margin="0,0,8,0" />
          <CheckBox Content=".*" IsChecked="{Binding SearchUseRegex}" ToolTip="{loc:StringLoc Key=Search_Regex}" />
          <Button Style="{StaticResource IconButton}" Content="{StaticResource CodiconMore}" FontFamily="{StaticResource IconFontFamily}"
                  ToolTip="{loc:StringLoc Key=Search_ToggleDetails}" Command="{Binding ToggleSearchDetailsCommand}" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Visibility="{Binding ShowSearchDetails, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,2,0,0">
          <TextBlock Text="{loc:StringLoc Key=Search_IncludeLabel}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="{DynamicResource TypeBody}" Margin="0,2,0,0" />
          <TextBox Text="{Binding IncludePattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:StringLoc Key=Search_Include}" Margin="0,2,0,0" />
          <TextBlock Text="{loc:StringLoc Key=Search_ExcludeLabel}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="{DynamicResource TypeBody}" Margin="0,5,0,0" />
          <TextBox Text="{Binding ExcludePattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:StringLoc Key=Search_Exclude}" Margin="0,2,0,0" />
          <CheckBox Content="{loc:StringLoc Key=Search_UseIgnoreFiles}" IsChecked="{Binding UseIgnoreFiles}" Margin="0,5,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding SearchErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasSearchError, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Grid Margin="0,5,0,2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="{DynamicResource TypeBody}" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="1" Content="{loc:StringLoc Key=Search_Cancel}" Style="{StaticResource PrimaryButton}" Command="{Binding CancelSearchCommand}"
                  Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="8,2" MinHeight="22" />
        </Grid>
        <TextBlock Text="{Binding SearchSummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource TypeBody}" />
        <TextBlock Text="{loc:StringLoc Key=Search_Truncated}" Foreground="{DynamicResource WarningBrush}" FontSize="{DynamicResource TypeBody}"
                   Visibility="{Binding IsTruncated, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </StackPanel>

      <ListBox ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource SidebarRowItemStyle}"
               Background="Transparent" BorderThickness="0" Padding="0,6,8,0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               PreviewMouseLeftButtonUp="SearchRows_PreviewMouseLeftButtonUp" />
      </DockPanel>
    </controls:SidebarShell.BodyContent>
  </controls:SidebarShell>
</UserControl>
