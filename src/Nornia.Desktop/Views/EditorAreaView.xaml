<UserControl x:Class="Nornia.Desktop.Views.EditorAreaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nornia.Desktop.ViewModels"
             xmlns:views="clr-namespace:Nornia.Desktop.Views">
  <UserControl.Resources>
    <!-- Diff tabs retain their dedicated editor-based inline / side-by-side viewer. File previews
         deliberately do not use a DataTemplate: the single preview surface below remains mounted
         across file-tab changes, preserving the document-outline shell and sash. -->
    <DataTemplate DataType="{x:Type vm:DiffTab}">
      <views:DiffDocumentView />
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="{DynamicResource EditorBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- A persistent FilePreviewView keeps the right-hand outline surface, sash width and editor
         chrome alive while switching between file tabs. Only its DataContext changes, so the
         bound outline entries refresh without reconstructing the entire sidebar. -->
    <views:FilePreviewView x:Name="PersistentFilePreview" Grid.Row="0"
                           DataContext="{Binding SelectedFileTab}"
                           Visibility="{Binding DataContext.HasSelectedFileTab, RelativeSource={RelativeSource AncestorType=views:EditorAreaView}, Converter={StaticResource BooleanToVisibilityConverter}}" />

    <!-- Non-file editor content is still selected through its type-specific template. -->
    <ContentControl Grid.Row="0" Content="{Binding SelectedDiffTab}" />
  </Grid>
</UserControl>
