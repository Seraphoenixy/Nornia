<UserControl x:Class="Nornia.Desktop.Views.Controls.SidebarRowChrome"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="SidebarRowExpanderStyle" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource IconChevron}" />
      <Setter Property="Content" Value="{StaticResource CodiconChevronDown}" />
      <Setter Property="Visibility" Value="{Binding ShowExpander, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="False">
          <Setter Property="Content" Value="{StaticResource CodiconChevronRight}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="{Binding Indent, ElementName=Root}" PreviewMouseLeftButtonUp="Row_PreviewMouseLeftButtonUp">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="18" />
      <ColumnDefinition x:Name="GlyphColumn" Width="0" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Button Grid.Column="0"
            Style="{StaticResource SidebarRowExpanderStyle}"
            Command="{Binding ToggleCommand, ElementName=Root}"
            CommandParameter="{Binding ToggleCommandParameter, ElementName=Root}" />
    <ContentPresenter Grid.Column="0"
                      Content="{Binding GlyphContent, ElementName=Root}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
      <ContentPresenter.Style>
        <Style TargetType="ContentPresenter">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding ShowGlyph, ElementName=Root}" Value="True" />
                <Condition Binding="{Binding GlyphInExpanderCell, ElementName=Root}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </ContentPresenter.Style>
    </ContentPresenter>
    <ContentPresenter Grid.Column="1"
                      Content="{Binding GlyphContent, ElementName=Root}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
      <ContentPresenter.Style>
        <Style TargetType="ContentPresenter">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding ShowGlyph, ElementName=Root}" Value="True" />
                <Condition Binding="{Binding GlyphInExpanderCell, ElementName=Root}" Value="False" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </ContentPresenter.Style>
    </ContentPresenter>
    <ContentPresenter Grid.Column="2"
                      Content="{Binding MainContent, ElementName=Root}"
                      MinWidth="0"
                      VerticalAlignment="Center" />
    <ContentPresenter Grid.Column="3"
                      Content="{Binding SecondaryContent, ElementName=Root}"
                      VerticalAlignment="Center" />
    <ContentPresenter Grid.Column="4"
                      Content="{Binding TrailingContent, ElementName=Root}"
                      VerticalAlignment="Center" />
  </Grid>
</UserControl>
