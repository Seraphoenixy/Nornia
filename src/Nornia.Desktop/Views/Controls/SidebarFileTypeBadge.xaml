<UserControl x:Class="Nornia.Desktop.Views.Controls.SidebarFileTypeBadge"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Viewbox Stretch="Fill" StretchDirection="DownOnly"
           Width="{DynamicResource IconMonogramSlot}"
           Height="{DynamicResource IconMonogramCell}"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Margin="0"
           ClipToBounds="False">
    <TextBlock Text="{Binding Path, ElementName=Root, Converter={StaticResource PathToIconMonogramConverter}}"
               Style="{StaticResource FileTypeMonogramTextStyle}"
               Width="Auto"
               Margin="0"
               Foreground="{Binding Path, ElementName=Root, Converter={StaticResource PathToIconBrushConverter}}" />
  </Viewbox>
</UserControl>
