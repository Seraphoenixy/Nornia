<UserControl x:Class="Nornia.Desktop.Views.Controls.CollapsibleSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <UserControl.Resources>
    <!-- VS Code-style section header: chevron + title + round count badge right beside the title,
         flat (no background, no borders — sections separate by spacing); the whole header toggles
         and the right-side action area (HeaderContent) reveals on hover. -->
    <Style x:Key="CollapsibleHeaderButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <!-- VS Code 侧栏分节头约 22px 行高,8px 横向内边距 → 随 SizeRowSm 令牌缩放 -->
      <Setter Property="MinHeight" Value="{DynamicResource SizeRowSm}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="HeaderRoot" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" CornerRadius="3">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Chevron" Grid.Column="0" Text="{StaticResource CodiconChevronRight}" FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconChevron}"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <!-- The toggle owns only the title. Actions and the count badge are siblings in
                     HeaderArea, which keeps the order Title -> actions -> badge. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="TitleText" FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold" VerticalAlignment="Center"
                             Foreground="{DynamicResource SideBarSectionHeaderForegroundBrush}" TextTrimming="CharacterEllipsis"
                             Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Visibility="{Binding Title, Converter={StaticResource NullToCollapsedConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
                <!-- Header (legacy API): arbitrary content, e.g. a styled TextBlock -->
                <ContentPresenter Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center"
                                  Content="{Binding Header, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Visibility="{Binding Header, Converter={StaticResource NullToCollapsedConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter TargetName="Chevron" Property="Text" Value="{StaticResource CodiconChevronDown}" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeaderRoot" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HeaderRoot" Property="Background" Value="{DynamicResource PressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <!-- 内容行用星号:Margin 使内容在宿主高度受限时获得有限视口(内部 ScrollViewer 才可
           滚动、滚动条才可见);宿主不受限(Auto 链)时星号退化为 Auto,行为不变。 -->
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <!-- Header area: hover anywhere (toggle button or actions) keeps the inline actions visible. -->
    <Grid x:Name="HeaderArea" Grid.Row="0" Background="Transparent">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="HeaderToggle" Grid.Column="0" Style="{StaticResource CollapsibleHeaderButtonStyle}"
              Click="HeaderToggle_Click" />
      <!-- VS Code: section-header inline actions reveal on hover only. -->
      <ContentPresenter Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"
                        Content="{Binding HeaderContent, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ContentPresenter.Style>
          <Style TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, ElementName=HeaderArea}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentPresenter.Style>
      </ContentPresenter>
      <!-- Keep the count badge in the final header column, after inline actions, so it is a
           stable right-edge anchor even when the action buttons appear. -->
      <Border x:Name="Badge" Grid.Column="2" Margin="0,0,8,0"
              Style="{StaticResource SidebarCountBadgeStyle}"
              HorizontalAlignment="Right">
        <Border.Visibility>
          <MultiBinding Converter="{StaticResource BadgeCountVisibilityConverter}">
            <Binding Path="BadgeCount" RelativeSource="{RelativeSource AncestorType=UserControl}" />
            <Binding Path="AlwaysShowBadge" RelativeSource="{RelativeSource AncestorType=UserControl}" />
          </MultiBinding>
        </Border.Visibility>
        <TextBlock Text="{Binding BadgeCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Style="{StaticResource SidebarCountBadgeTextStyle}" />
      </Border>
    </Grid>
    <ContentPresenter Grid.Row="1" Margin="8,0,0,0"
                      Content="{Binding SectionContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
  </Grid>
</UserControl>
