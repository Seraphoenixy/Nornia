<UserControl x:Class="Nornia.Desktop.Views.GitPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nornia.Desktop.Views">
  <!-- VS Code editor blank area: this page is the diff workspace of the 源代码管理 activity; the
       source-control entry points live in the left sidebar, so the empty state only points there. -->
  <views:EmptyStateControl Icon="{StaticResource CodiconDiff}" Title="没有打开的差异"
                           Description="从左侧源代码管理的更改、暂存更改或历史提交中选择一项，差异将在此打开。" />
</UserControl>
