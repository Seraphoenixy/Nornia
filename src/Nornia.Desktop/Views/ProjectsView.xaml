<UserControl x:Class="Nornia.Desktop.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nornia.Desktop.Views">
  <!-- Editor area: selected project environment workflow (the catalog lives in the secondary sidebar) -->
  <Grid Background="{DynamicResource EditorBrush}" Margin="{StaticResource InsetPage}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

    <!-- Page title row: title left, environment summary right (same hierarchy as the other pages) -->
    <DockPanel Grid.Row="0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Right" Text="{Binding ProfileSummary}" VerticalAlignment="Center"
                 Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource TypeBody}" TextTrimming="CharacterEllipsis" Margin="{StaticResource GapLeftSm}" />
      <TextBlock Text="项目管理" Style="{StaticResource PageTitleStyle}" />
    </DockPanel>

    <!-- Current project context -->
    <DockPanel Grid.Row="1" Margin="{StaticResource MarginFieldRow}" LastChildFill="False">
      <Button Content="浏览…" Command="{Binding BrowseCommand}" DockPanel.Dock="Right" Margin="{StaticResource GapLeftSm}" ToolTip="选择项目目录" />
      <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="项目目录路径" />
    </DockPanel>

    <!-- Workflow actions (state-driven): right-aligned, wrap to a second line when the editor
         column narrows so the primary action never clips -->
    <Grid Grid.Row="2" Margin="{StaticResource MarginActionsRow}">
      <WrapPanel Style="{StaticResource ToolbarActionsStyle}">
        <Button Content="初始化环境" Command="{Binding InitializeCommand}" ToolTip="{Binding InitializeTooltip}" />
        <Button Content="检查环境" Command="{Binding CheckCommand}" Style="{StaticResource PrimaryButton}" ToolTip="{Binding CheckTooltip}" />
        <Button Content="预览修复" Command="{Binding PlanRepairCommand}" ToolTip="{Binding PlanRepairTooltip}" />
        <Button Content="应用修复" Command="{Binding ApplyRepairCommand}" Style="{StaticResource DangerButton}" ToolTip="{Binding ApplyRepairTooltip}" />
      </WrapPanel>
    </Grid>

    <!-- Check results -->
    <Grid Grid.Row="3">
      <DataGrid ItemsSource="{Binding CheckResults}" AlternationCount="2" CanUserSortColumns="True" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="状态" Width="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="{DynamicResource IconInline}" VerticalAlignment="Center" Margin="{StaticResource GapRightSm}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                        <Setter Property="Text" Value="{StaticResource CodiconInfo}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Status}" Value="Pass"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /><Setter Property="Text" Value="{StaticResource CodiconCheck}" /></DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /><Setter Property="Text" Value="{StaticResource CodiconWarning}" /></DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /><Setter Property="Text" Value="{StaticResource CodiconError}" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                        <Setter Property="Text" Value="未检查" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Status}" Value="Pass"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /><Setter Property="Text" Value="通过" /></DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /><Setter Property="Text" Value="警告" /></DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /><Setter Property="Text" Value="失败" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="组件" Binding="{Binding Component}" Width="150" />
          <DataGridTextColumn Header="要求" Binding="{Binding RequiredVersion}" Width="110" />
          <DataGridTextColumn Header="已安装" Binding="{Binding InstalledVersion}" Width="110" />
          <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
      <Border Background="{DynamicResource EditorBrush}" Visibility="{Binding IsCheckResultsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
        <views:EmptyStateControl Icon="{StaticResource CodiconBeaker}" Title="尚无检查结果。" Description="选择项目目录后点击“检查环境”。"
                                 ActionText="检查环境" ActionCommand="{Binding CheckCommand}" />
      </Border>
    </Grid>

    <!-- Repair plan status strip (result feedback zone) -->
    <TextBlock Grid.Row="4" Margin="{StaticResource GapBottomSm}" Text="{Binding RepairSummary}" ToolTip="{Binding RepairSummary}"
               Visibility="{Binding RepairSummary, Converter={StaticResource StringEmptyToCollapsedConverter}}">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource ResultStripStyle}" />
      </TextBlock.Style>
    </TextBlock>
  </Grid>
</UserControl>
