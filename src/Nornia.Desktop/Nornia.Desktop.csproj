<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Brand tile for the exe/taskbar/Alt-Tab; regenerated by tools/GenerateAppIcon. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Window.Icon pack-URI resource (same brand tile as the exe icon). -->
    <Resource Include="Assets\app.ico" />
    <!-- VS Code Codicon font generated from vscode-codicons-main. -->
    <Resource Include="Assets\codicon.ttf" />
    <None Include="Assets\codicon.NOTICE.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\\Nornia.Composition\\Nornia.Composition.csproj" />
    <ProjectReference Include="..\\Nornia.Core\\Nornia.Core.csproj" />
    <ProjectReference Include="..\\Nornia.Runtime\\Nornia.Runtime.csproj" />
    <ProjectReference Include="..\\Nornia.Package\\Nornia.Package.csproj" />
    <ProjectReference Include="..\\Nornia.Project\\Nornia.Project.csproj" />
    <ProjectReference Include="..\\Nornia.Storage\\Nornia.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Read-only code reading workbench (MIT): syntax highlighting / folding / custom rendering. -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- TextMate tokenization used by the read-only language-presentation pipeline (MIT). -->
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
    <!-- C# document outline via the syntax tree. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- Markdown AST and WPF-native TeX formula rendering. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>
  <!-- Keep both supported Windows native assets in RID-specific directories. Runtime resolution
       selects the matching architecture; absence degrades TextMate for that document only. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Content Include="$(NuGetPackageRoot)onigwrap\1.0.11\runtimes\win-x64\native\libonigwrap.dll"
             Link="runtimes\win-x64\native\libonigwrap.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)onigwrap\1.0.11\runtimes\win-arm64\native\libonigwrap.dll"
             Link="runtimes\win-arm64\native\libonigwrap.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests construct TerminalSession (internal ctor) to exercise terminal shortcut routing. -->
    <InternalsVisibleTo Include="Nornia.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Localization: embedded raw XML read by ResourceHelper (avoids designer-file generation). -->
    <EmbeddedResource Include="Localization\AppResources.xml" />
    <EmbeddedResource Include="Localization\AppResources.*.xml" />
    <EmbeddedResource Include="Code\GrammarManifest.json" />
  </ItemGroup>
</Project>
